const MVP_GALLERY_STYLE = `
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@600;700;800;900&display=swap');

.records-mvp-serif {
  font-family: 'Noto Serif KR', 'Nanum Myeongjo', 'Batang', serif;
}

@keyframes recordsMvpLightBreath {
  0%, 100% { opacity: .48; transform: translateX(-50%) scale(.96); }
  50% { opacity: .78; transform: translateX(-50%) scale(1.04); }
}

@keyframes recordsMvpFrameBreath {
  0%, 100% {
    box-shadow:
      0 18px 42px rgba(0,0,0,.30),
      0 0 0 1px rgba(255,231,180,.02),
      0 0 26px rgba(255,211,118,.07);
  }
  50% {
    box-shadow:
      0 22px 48px rgba(0,0,0,.34),
      0 0 0 1px rgba(255,231,180,.035),
      0 0 36px rgba(255,211,118,.12);
  }
}

.records-mvp-light {
  animation: recordsMvpLightBreath 7.8s ease-in-out infinite;
}

.records-mvp-showcase {
  animation: recordsMvpFrameBreath 8.8s ease-in-out infinite;
}

@keyframes recordsMvpPremiumReveal {
  0% { opacity: .72; transform: translateY(6px); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes recordsMvpSigilDrift {
  0% { transform: translate(-50%, -50%) rotate(0deg) scale(.98); opacity: .32; }
  50% { transform: translate(-50%, -50%) rotate(180deg) scale(1.03); opacity: .52; }
  100% { transform: translate(-50%, -50%) rotate(360deg) scale(.98); opacity: .32; }
}

@keyframes recordsMvpParticleFloat {
  0%, 100% { transform: translate3d(0, 8px, 0) scale(.78); opacity: 0; }
  20% { opacity: .72; }
  72% { opacity: .36; }
  100% { transform: translate3d(8px, -72px, 0) scale(1.12); opacity: 0; }
}

@keyframes recordsMvpTitleShimmer {
  0%, 100% { filter: drop-shadow(0 0 8px var(--mvp-glow)); }
  50% { filter: drop-shadow(0 0 15px var(--mvp-glow)); }
}

.records-mvp-premium {
  animation: recordsMvpPremiumReveal .7s ease-out both;
  background:
    radial-gradient(circle at 22% 45%, var(--mvp-soft-glow), transparent 33%),
    radial-gradient(circle at 76% 38%, var(--mvp-soft-glow), transparent 32%),
    linear-gradient(145deg, var(--mvp-panel), var(--mvp-bg));
  border-color: var(--mvp-border);
  box-shadow: 0 24px 56px rgba(0,0,0,.38), inset 0 0 0 1px rgba(255,255,255,.025), 0 0 34px var(--mvp-soft-glow);
}

.records-mvp-premium::before {
  content: '';
  position: absolute;
  inset: 8px;
  pointer-events: none;
  border: 1px solid var(--mvp-border);
  opacity: .34;
  border-radius: 20px;
  z-index: 1;
}

.records-mvp-premium::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .34;
  background-image: linear-gradient(115deg, transparent 0 46%, rgba(255,255,255,.035) 48%, transparent 50% 100%);
  z-index: 0;
}

.records-mvp-ornament {
  color: var(--mvp-accent);
  text-shadow: 0 0 12px var(--mvp-glow);
}

.records-mvp-sigil {
  position: absolute;
  left: 72%;
  top: 50%;
  width: 260px;
  height: 260px;
  transform: translate(-50%, -50%);
  border: 1px solid var(--mvp-primary);
  border-radius: 999px;
  opacity: .26;
  animation: recordsMvpSigilDrift 28s linear infinite;
  box-shadow: inset 0 0 34px var(--mvp-soft-glow), 0 0 28px var(--mvp-soft-glow);
}

.records-mvp-sigil::before,
.records-mvp-sigil::after {
  content: '';
  position: absolute;
  border-radius: inherit;
  border: 1px solid var(--mvp-secondary);
  opacity: .54;
}

.records-mvp-sigil::before { inset: 24px; }
.records-mvp-sigil::after { inset: 55px; border-style: dashed; }

.records-mvp-sigil-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 54px;
  color: var(--mvp-accent);
  opacity: .72;
  text-shadow: 0 0 24px var(--mvp-glow);
}

.records-mvp-particle {
  position: absolute;
  width: 3px;
  height: 3px;
  border-radius: 999px;
  background: var(--mvp-particle);
  box-shadow: 0 0 9px var(--mvp-particle);
  animation: recordsMvpParticleFloat 6.8s ease-in-out infinite;
}
.records-mvp-particle:nth-child(2n) { width: 2px; height: 2px; animation-duration: 8.4s; }
.records-mvp-particle:nth-child(3n) { animation-delay: -2.3s; }
.records-mvp-particle:nth-child(4n) { animation-delay: -4.1s; }

.records-mvp-incarnation-title {
  animation: recordsMvpTitleShimmer 5.4s ease-in-out infinite;
}

.records-mvp-rival-tile {
  border-color: var(--mvp-border);
  background: linear-gradient(180deg, var(--mvp-panel), rgba(0,0,0,.42));
  box-shadow: inset 0 0 18px rgba(255,255,255,.018);
}

.records-mvp-rival-placeholder {
  background:
    radial-gradient(circle at 50% 30%, var(--mvp-soft-glow), transparent 42%),
    linear-gradient(135deg, rgba(255,255,255,.035), rgba(0,0,0,.38));
}

.records-mvp-premium[data-mvp-theme='EMBER_CORE'] .records-mvp-sigil { border-style: double; }
.records-mvp-premium[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-sigil::after { transform: rotate(22.5deg); border-style: solid; }
.records-mvp-premium[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-sigil::after { border-style: dotted; }
.records-mvp-premium[data-mvp-theme='PROCESSION_LINK'] .records-mvp-sigil { border-left-color: transparent; border-bottom-color: transparent; }
.records-mvp-premium[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-sigil { box-shadow: inset 0 0 36px rgba(151,198,172,.13), 0 0 34px rgba(239,220,188,.12); }
/* -------------------------------------------------------------------------- */
/* Monthly MVP premium archive V4 refinements                                 */
/* -------------------------------------------------------------------------- */
@keyframes recordsMvpV4Reveal {
  0% { opacity: .76; transform: translateY(7px); }
  100% { opacity: 1; transform: translateY(0); }
}

@keyframes recordsMvpV4TitleGlow {
  0%, 100% { filter: drop-shadow(0 0 7px var(--mvp-glow)); }
  50% { filter: drop-shadow(0 0 14px var(--mvp-glow)); }
}

@keyframes recordsMvpV4HaloDrift {
  0% { transform: translate(-50%, -50%) rotate(0deg); opacity: .19; }
  50% { opacity: .29; }
  100% { transform: translate(-50%, -50%) rotate(360deg); opacity: .19; }
}

@keyframes recordsMvpV4EmberPulse {
  0%, 100% { opacity: .36; transform: translate(-50%, -50%) scale(.97); }
  50% { opacity: .68; transform: translate(-50%, -50%) scale(1.025); }
}

.records-mvp-premium-v4 {
  animation: recordsMvpV4Reveal .72s ease-out both;
  background:
    radial-gradient(circle at 20% 50%, color-mix(in srgb, var(--mvp-soft-glow) 84%, transparent), transparent 33%),
    radial-gradient(circle at 76% 43%, color-mix(in srgb, var(--mvp-soft-glow) 90%, transparent), transparent 32%),
    linear-gradient(145deg, var(--mvp-panel), var(--mvp-bg));
  box-shadow:
    0 28px 70px rgba(0,0,0,.42),
    inset 0 0 0 1px rgba(255,255,255,.026),
    0 0 34px color-mix(in srgb, var(--mvp-soft-glow) 72%, transparent);
}

.records-mvp-premium-v4::before {
  inset: 11px;
  opacity: .31;
  border-radius: 22px;
}

.records-mvp-crest-v4 {
  width: 44px;
  height: 44px;
  margin-top: -9px;
  background:
    radial-gradient(circle, color-mix(in srgb, var(--mvp-soft-glow) 90%, transparent), rgba(0,0,0,.30) 69%);
}

.records-mvp-sigil-v4 {
  left: 75%;
  top: 52%;
  width: min(36vw, 500px);
  opacity: .12;
  box-shadow: inset 0 0 46px var(--mvp-soft-glow), 0 0 32px var(--mvp-soft-glow);
}

.records-mvp-sigil-v4::before { inset: 12%; }
.records-mvp-sigil-v4::after { inset: 27%; }

.records-mvp-particle-v4 {
  opacity: .8;
}

.records-mvp-portrait-shell-v4 {
  box-shadow:
    0 24px 60px rgba(0,0,0,.46),
    0 0 24px color-mix(in srgb, var(--mvp-soft-glow) 68%, transparent);
}

.records-mvp-incarnation-stage-v4 {
  border-top: 1px solid color-mix(in srgb, var(--mvp-border) 46%, transparent);
  border-bottom: 1px solid color-mix(in srgb, var(--mvp-border) 38%, transparent);
  background:
    radial-gradient(ellipse at 50% 54%, color-mix(in srgb, var(--mvp-soft-glow) 88%, transparent), transparent 60%),
    linear-gradient(90deg, transparent, rgba(255,255,255,.022), transparent);
}

.records-mvp-incarnation-stage-v4::before {
  width: min(58%, 380px);
  opacity: .17;
}

.records-mvp-incarnation-stage-v4::after {
  width: min(74%, 500px);
  height: 68%;
  opacity: .58;
}

.records-mvp-incarnation-halo-v4 {
  width: min(62%, 410px);
  opacity: .19;
  animation: recordsMvpV4HaloDrift 34s linear infinite;
}

.records-mvp-incarnation-rune-v4 {
  font-size: clamp(58px,7.5vw,108px);
  opacity: .055;
}

.records-mvp-incarnation-title-v4 {
  width: min(100%, 760px);
  font-size: clamp(2.2rem,4.15vw,3.85rem);
  white-space: nowrap;
  text-align: center;
  animation: recordsMvpV4TitleGlow 5.6s ease-in-out infinite;
  text-shadow:
    0 12px 28px rgba(0,0,0,.52),
    0 0 14px var(--mvp-glow);
}

.records-mvp-rival-tile-v4 {
  background:
    linear-gradient(180deg, color-mix(in srgb, var(--mvp-panel) 92%, black), rgba(0,0,0,.47));
  box-shadow:
    inset 0 0 18px rgba(255,255,255,.016),
    0 10px 20px rgba(0,0,0,.15);
}

.records-mvp-rival-placeholder-v4 {
  background:
    radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--mvp-soft-glow) 86%, transparent), transparent 46%),
    linear-gradient(135deg, rgba(255,255,255,.018), rgba(0,0,0,.34));
}

.records-mvp-premium-v4[data-mvp-theme='DAWN_CALLER'] .records-mvp-incarnation-stage-v4 {
  background:
    radial-gradient(ellipse at center, rgba(136,191,255,.17), transparent 61%),
    linear-gradient(90deg, transparent, rgba(184,216,255,.025), transparent);
}

.records-mvp-premium-v4[data-mvp-theme='EMBER_CORE'] .records-mvp-incarnation-stage-v4::after {
  background:
    radial-gradient(ellipse at center, rgba(255,166,82,.28) 0%, rgba(255,99,31,.13) 35%, transparent 67%);
  opacity: .92;
  animation: recordsMvpV4EmberPulse 5.4s ease-in-out infinite;
}

.records-mvp-premium-v4[data-mvp-theme='EMBER_CORE'] .records-mvp-incarnation-halo-v4 {
  opacity: .29;
  filter: drop-shadow(0 0 10px rgba(255,112,30,.34));
}

.records-mvp-premium-v4[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-incarnation-halo-v4 {
  transform: translate(-50%, -50%) rotate(22.5deg);
  opacity: .22;
}

.records-mvp-premium-v4[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-incarnation-stage-v4::before {
  border-style: dotted;
}

.records-mvp-premium-v4[data-mvp-theme='PROCESSION_LINK'] .records-mvp-incarnation-stage-v4::before {
  border-left-color: transparent;
  border-bottom-color: transparent;
  transform: translate(-50%, -50%) rotate(-22deg);
}

.records-mvp-premium-v4[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-incarnation-stage-v4::after {
  background:
    radial-gradient(ellipse at 41% 50%, rgba(243,228,196,.19), transparent 50%),
    radial-gradient(ellipse at 63% 50%, rgba(151,198,172,.17), transparent 52%);
  opacity: .84;
}

@media (max-width: 1023px) {
  .records-mvp-sigil-v4 {
    left: 50%;
    top: 66%;
    width: min(80vw, 500px);
  }
  .records-mvp-incarnation-title-v4 {
    font-size: clamp(2rem,6.6vw,3.45rem);
  }
}

@media (max-width: 640px) {
  .records-mvp-incarnation-title-v4 {
    white-space: normal;
    font-size: clamp(1.85rem,9.2vw,2.75rem);
    line-height: 1.07;
  }
  .records-mvp-incarnation-stage-v4 {
    min-height: 185px;
  }
}

/* -------------------------------------------------------------------------- */
/* Monthly MVP premium archive V5 compact two-column refinements               */
/* -------------------------------------------------------------------------- */
.records-mvp-premium-v5 {
  min-width: 0;
  background:
    radial-gradient(circle at 23% 48%, color-mix(in srgb, var(--mvp-soft-glow) 58%, transparent), transparent 29%),
    radial-gradient(circle at 73% 47%, color-mix(in srgb, var(--mvp-soft-glow) 48%, transparent), transparent 30%),
    linear-gradient(145deg, var(--mvp-panel), var(--mvp-bg));
  box-shadow:
    0 20px 46px rgba(0,0,0,.36),
    inset 0 0 0 1px rgba(255,255,255,.02),
    0 0 22px color-mix(in srgb, var(--mvp-soft-glow) 46%, transparent);
}

.records-mvp-premium-v5::before {
  inset: 10px;
  border-radius: 19px;
  opacity: .24;
}

.records-mvp-v5-corner {
  position: absolute;
  z-index: 1;
  color: var(--mvp-secondary);
  font-size: 11px;
  line-height: 1;
  opacity: .62;
}
.records-mvp-v5-corner-tl { left: 12px; top: 10px; }
.records-mvp-v5-corner-tr { right: 12px; top: 10px; }
.records-mvp-v5-corner-bl { left: 12px; bottom: 10px; }
.records-mvp-v5-corner-br { right: 12px; bottom: 10px; }

.records-mvp-incarnation-stage-v5 {
  box-shadow:
    inset 0 0 22px rgba(0,0,0,.16),
    0 0 14px color-mix(in srgb, var(--mvp-soft-glow) 46%, transparent);
}

.records-mvp-v5-ring {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 1px solid;
  border-radius: 999px;
  transform: translate(-50%, -50%);
  pointer-events: none;
}
.records-mvp-v5-ring-outer {
  width: 176px;
  height: 176px;
  opacity: .18;
}
.records-mvp-v5-ring-inner {
  width: 118px;
  height: 118px;
  opacity: .13;
  border-style: dashed;
}
.records-mvp-v5-rune {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 62px;
  font-weight: 900;
  opacity: .045;
  pointer-events: none;
}
.records-mvp-v5-ornament {
  filter: drop-shadow(0 0 7px var(--mvp-glow));
}
.records-mvp-incarnation-title-v5 {
  filter: drop-shadow(0 0 6px var(--mvp-soft-glow));
}
.records-mvp-v5-rival {
  background: linear-gradient(180deg, color-mix(in srgb, var(--mvp-panel) 88%, black), rgba(0,0,0,.34));
  box-shadow: inset 0 0 10px rgba(255,255,255,.012);
}

.records-mvp-premium-v5[data-mvp-theme='EMBER_CORE'] .records-mvp-incarnation-stage-v5 {
  background:
    radial-gradient(circle at 50% 50%, rgba(255,151,60,.18), transparent 45%),
    radial-gradient(circle at 50% 50%, rgba(255,89,24,.08), transparent 67%),
    rgba(0,0,0,.14) !important;
}
.records-mvp-premium-v5[data-mvp-theme='DAWN_CALLER'] .records-mvp-incarnation-stage-v5 {
  background: radial-gradient(circle at 50% 48%, rgba(136,191,255,.12), transparent 62%), rgba(0,0,0,.12) !important;
}
.records-mvp-premium-v5[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-incarnation-stage-v5 {
  background: radial-gradient(circle at 50% 48%, rgba(201,79,97,.12), transparent 62%), rgba(0,0,0,.12) !important;
}
.records-mvp-premium-v5[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-incarnation-stage-v5 {
  background: radial-gradient(circle at 50% 48%, rgba(59,143,216,.12), transparent 62%), rgba(0,0,0,.12) !important;
}
.records-mvp-premium-v5[data-mvp-theme='PROCESSION_LINK'] .records-mvp-incarnation-stage-v5 {
  background: radial-gradient(circle at 50% 48%, rgba(208,155,86,.10), transparent 62%), rgba(0,0,0,.12) !important;
}
.records-mvp-premium-v5[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-incarnation-stage-v5 {
  background:
    radial-gradient(circle at 43% 48%, rgba(243,228,196,.10), transparent 52%),
    radial-gradient(circle at 61% 48%, rgba(151,198,172,.09), transparent 55%),
    rgba(0,0,0,.12) !important;
}

@media (max-width: 640px) {
  .records-mvp-incarnation-title-v5 {
    font-size: clamp(1.25rem, 6.5vw, 1.75rem);
    white-space: normal;
    line-height: 1.06;
  }
  .records-mvp-v5-ring-outer { width: 154px; height: 154px; }
  .records-mvp-v5-ring-inner { width: 104px; height: 104px; }
}

/* -------------------------------------------------------------------------- */
/* Monthly MVP premium archive V6: adaptive title + open ceremonial stage      */
/* -------------------------------------------------------------------------- */
.records-mvp-premium-v6 {
  min-width: 0;
}

.records-mvp-incarnation-stage-v6 {
  isolation: isolate;
  background: transparent;
}

.records-mvp-incarnation-stage-v6::before,
.records-mvp-incarnation-stage-v6::after {
  content: '';
  position: absolute;
  pointer-events: none;
  z-index: 0;
}

.records-mvp-v6-theme-art {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .95;
}

.records-mvp-v6-theme-mark {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 0;
  transform: translate(-50%, -50%);
  color: var(--mvp-accent);
  font-size: 43px;
  font-weight: 900;
  line-height: 1;
  opacity: .055;
  filter: drop-shadow(0 0 12px var(--mvp-soft-glow));
  pointer-events: none;
}

.records-mvp-v6-label-line {
  width: 18px;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--mvp-secondary));
  opacity: .56;
}
.records-mvp-v6-label-line:last-child {
  transform: scaleX(-1);
}

.records-mvp-incarnation-title-v6 {
  filter: drop-shadow(0 0 5px var(--mvp-soft-glow));
  text-wrap: nowrap;
}

.records-mvp-v6-rival {
  background: linear-gradient(180deg, color-mix(in srgb, var(--mvp-panel) 82%, black), rgba(0,0,0,.28));
  box-shadow: inset 0 0 9px rgba(255,255,255,.012);
}

/* 3월 · DAWN_CALLER — 별자리와 천문환 */
.records-mvp-premium-v6[data-mvp-theme='DAWN_CALLER'] .records-mvp-v6-theme-art {
  background:
    radial-gradient(circle at 17% 37%, rgba(184,216,255,.62) 0 1px, transparent 1.6px),
    radial-gradient(circle at 28% 68%, rgba(136,191,255,.42) 0 1px, transparent 1.6px),
    radial-gradient(circle at 72% 31%, rgba(230,232,222,.54) 0 1px, transparent 1.6px),
    radial-gradient(circle at 84% 64%, rgba(136,191,255,.40) 0 1px, transparent 1.6px),
    radial-gradient(ellipse at 50% 54%, rgba(136,191,255,.105), transparent 58%);
  animation: recordsMvpV6Twinkle 7.2s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='DAWN_CALLER'] .records-mvp-incarnation-stage-v6::before {
  left: 50%; top: 52%; width: 128px; height: 128px;
  transform: translate(-50%,-50%);
  border: 1px solid rgba(184,216,255,.17);
  border-radius: 50%;
  box-shadow: 0 0 0 18px rgba(136,191,255,.028), 0 0 0 36px rgba(136,191,255,.018);
}
.records-mvp-premium-v6[data-mvp-theme='DAWN_CALLER'] .records-mvp-incarnation-stage-v6::after {
  left: 21%; right: 21%; top: 51%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(184,216,255,.20), transparent);
  transform: rotate(-12deg);
}

/* 4월 · EMBER_CORE — 점화 코어와 기계식 기어 */
.records-mvp-premium-v6[data-mvp-theme='EMBER_CORE'] .records-mvp-v6-theme-art {
  left: 50%; top: 50%; right: auto; bottom: auto;
  width: 142px; height: 142px;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: repeating-conic-gradient(from 0deg, rgba(216,162,91,.18) 0deg 2deg, transparent 2deg 16deg);
  -webkit-mask: radial-gradient(circle, transparent 0 42%, #000 43% 45%, transparent 46% 58%, #000 59% 61%, transparent 62%);
  mask: radial-gradient(circle, transparent 0 42%, #000 43% 45%, transparent 46% 58%, #000 59% 61%, transparent 62%);
  opacity: .74;
  animation: recordsMvpV6Gear 26s linear infinite;
}
.records-mvp-premium-v6[data-mvp-theme='EMBER_CORE'] .records-mvp-incarnation-stage-v6::before {
  left: 50%; top: 53%; width: 58px; height: 58px;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,221,158,.16) 0 8%, rgba(255,151,60,.12) 10% 24%, rgba(255,89,24,.05) 38%, transparent 68%);
  box-shadow: 0 0 20px rgba(255,112,30,.13);
  animation: recordsMvpV6CorePulse 4.8s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='EMBER_CORE'] .records-mvp-incarnation-stage-v6::after {
  left: 13%; right: 13%; top: 53%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(216,162,91,.22) 24%, rgba(255,232,187,.38) 50%, rgba(216,162,91,.22) 76%, transparent);
}

/* 5월 · BLOOM_POTENTIAL — 장미가 피어나는 꽃잎 문양 */
.records-mvp-premium-v6[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-v6-theme-art {
  background:
    radial-gradient(ellipse 18% 34% at 50% 29%, rgba(201,79,97,.115), transparent 70%),
    radial-gradient(ellipse 18% 34% at 72% 43%, rgba(179,41,59,.105), transparent 70%),
    radial-gradient(ellipse 18% 34% at 68% 69%, rgba(214,166,91,.080), transparent 70%),
    radial-gradient(ellipse 18% 34% at 32% 69%, rgba(179,41,59,.105), transparent 70%),
    radial-gradient(ellipse 18% 34% at 28% 43%, rgba(201,79,97,.115), transparent 70%),
    radial-gradient(circle at 50% 51%, rgba(214,166,91,.09), transparent 38%);
  animation: recordsMvpV6Bloom 7.8s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-incarnation-stage-v6::before {
  left: 50%; top: 52%; width: 92px; height: 92px;
  transform: translate(-50%,-50%) rotate(45deg);
  border: 1px solid rgba(214,166,91,.13);
  border-radius: 42% 58% 44% 56%;
}
.records-mvp-premium-v6[data-mvp-theme='BLOOM_POTENTIAL'] .records-mvp-incarnation-stage-v6::after {
  left: 24%; right: 24%; bottom: 15%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,79,97,.18), rgba(214,166,91,.20), rgba(201,79,97,.18), transparent);
}

/* 6월 · PATHFINDER_TIDE — 나침반과 항로 */
.records-mvp-premium-v6[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-v6-theme-art {
  left: 50%; top: 52%; right: auto; bottom: auto;
  width: 132px; height: 132px;
  transform: translate(-50%,-50%);
  border-radius: 50%;
  background:
    linear-gradient(90deg, transparent 49.5%, rgba(120,188,231,.18) 49.8% 50.2%, transparent 50.5%),
    linear-gradient(0deg, transparent 49.5%, rgba(120,188,231,.18) 49.8% 50.2%, transparent 50.5%),
    conic-gradient(from 45deg, transparent 0 10%, rgba(240,207,130,.12) 10.5% 11.5%, transparent 12% 23%, rgba(120,188,231,.10) 23.5% 24.5%, transparent 25% 100%);
  border: 1px solid rgba(120,188,231,.14);
  animation: recordsMvpV6Compass 12s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-incarnation-stage-v6::before {
  left: 15%; top: 67%; width: 70%; height: 26px;
  border-top: 1px solid rgba(120,188,231,.16);
  border-radius: 50%;
  transform: rotate(-7deg);
}
.records-mvp-premium-v6[data-mvp-theme='PATHFINDER_TIDE'] .records-mvp-incarnation-stage-v6::after {
  left: 18%; right: 18%; top: 36%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(240,207,130,.22), transparent);
  transform: rotate(-18deg);
}

/* 7월 · PROCESSION_LINK — 초승달과 이어지는 행렬의 빛 */
.records-mvp-premium-v6[data-mvp-theme='PROCESSION_LINK'] .records-mvp-v6-theme-art {
  background:
    radial-gradient(circle at 19% 62%, rgba(242,203,133,.22) 0 1.2px, transparent 1.8px),
    radial-gradient(circle at 32% 55%, rgba(208,155,86,.18) 0 1.2px, transparent 1.8px),
    radial-gradient(circle at 46% 51%, rgba(242,203,133,.16) 0 1.2px, transparent 1.8px),
    radial-gradient(circle at 61% 47%, rgba(208,155,86,.15) 0 1.2px, transparent 1.8px),
    radial-gradient(circle at 77% 41%, rgba(242,203,133,.20) 0 1.2px, transparent 1.8px),
    radial-gradient(ellipse at 54% 52%, rgba(208,155,86,.07), transparent 55%);
  animation: recordsMvpV6Procession 8.5s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='PROCESSION_LINK'] .records-mvp-incarnation-stage-v6::before {
  left: 53%; top: 50%; width: 92px; height: 92px;
  transform: translate(-50%,-50%) rotate(-22deg);
  border: 1px solid rgba(242,203,133,.15);
  border-left-color: transparent;
  border-bottom-color: transparent;
  border-radius: 50%;
}
.records-mvp-premium-v6[data-mvp-theme='PROCESSION_LINK'] .records-mvp-incarnation-stage-v6::after {
  left: 15%; width: 70%; top: 59%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(208,155,86,.16) 20%, rgba(242,203,133,.25) 55%, transparent);
  transform: rotate(-9deg);
}

/* 9월 · AURORA_REBIRTH — 달과 오로라의 재기 */
.records-mvp-premium-v6[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-v6-theme-art {
  background:
    linear-gradient(112deg, transparent 16%, rgba(151,198,172,.075) 31%, transparent 44%),
    linear-gradient(72deg, transparent 34%, rgba(243,228,196,.065) 48%, transparent 62%),
    linear-gradient(122deg, transparent 52%, rgba(151,198,172,.065) 65%, transparent 78%),
    radial-gradient(ellipse at 54% 52%, rgba(243,228,196,.075), transparent 58%);
  animation: recordsMvpV6Aurora 9s ease-in-out infinite;
}
.records-mvp-premium-v6[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-incarnation-stage-v6::before {
  right: 18%; top: 19%; width: 48px; height: 48px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255,253,245,.11), rgba(243,228,196,.045) 58%, transparent 62%);
  border: 1px solid rgba(243,228,196,.14);
  box-shadow: 0 0 18px rgba(243,228,196,.07);
}
.records-mvp-premium-v6[data-mvp-theme='AURORA_REBIRTH'] .records-mvp-incarnation-stage-v6::after {
  left: 17%; right: 17%; bottom: 14%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(211,185,135,.15), rgba(151,198,172,.20), transparent);
}

@keyframes recordsMvpV6Twinkle {
  0%,100% { opacity: .76; }
  50% { opacity: 1; }
}
@keyframes recordsMvpV6Gear {
  from { transform: translate(-50%,-50%) rotate(0deg); }
  to { transform: translate(-50%,-50%) rotate(360deg); }
}
@keyframes recordsMvpV6CorePulse {
  0%,100% { opacity: .70; transform: translate(-50%,-50%) scale(.94); }
  50% { opacity: 1; transform: translate(-50%,-50%) scale(1.06); }
}
@keyframes recordsMvpV6Bloom {
  0%,100% { opacity: .72; transform: scale(.97); }
  50% { opacity: .95; transform: scale(1.02); }
}
@keyframes recordsMvpV6Compass {
  0%,100% { opacity: .68; transform: translate(-50%,-50%) rotate(-1.5deg); }
  50% { opacity: .9; transform: translate(-50%,-50%) rotate(1.5deg); }
}
@keyframes recordsMvpV6Procession {
  0%,100% { opacity: .72; transform: translateX(-2px); }
  50% { opacity: .95; transform: translateX(2px); }
}
@keyframes recordsMvpV6Aurora {
  0%,100% { opacity: .66; transform: translateX(-2px) skewX(-1deg); }
  50% { opacity: .92; transform: translateX(2px) skewX(1deg); }
}

@media (max-width: 640px) {
  .records-mvp-incarnation-title-v6 {
    font-size: clamp(1.05rem, 5.3vw, 1.45rem) !important;
    white-space: normal;
    line-height: 1.08;
  }
  .records-mvp-incarnation-stage-v6 {
    min-height: 94px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .records-mvp-premium-v6 .records-mvp-v6-theme-art,
  .records-mvp-premium-v6 .records-mvp-incarnation-stage-v6::before,
  .records-mvp-premium-v6 .records-mvp-incarnation-stage-v6::after {
    animation: none !important;
  }
}

@media (prefers-reduced-motion: reduce) {
  .records-mvp-light,
  .records-mvp-showcase,
  .records-mvp-premium,
  .records-mvp-sigil,
  .records-mvp-particle,
  .records-mvp-incarnation-title {
    animation: none;
  }
  .records-mvp-incarnation-title-v4,
  .records-mvp-incarnation-halo-v4,
  .records-mvp-premium-v4 {
    animation: none;
  }
}
`;

export function RecordsMonthlyMvpPanel() {
  const archiveQ = useQuery({
    queryKey: ['f4d-monthly-mvp-archive'],
    queryFn: () => recordsHistoryRpc.monthlyMvpArchive(supabase),
    staleTime: 5 * 60 * 1000,
  });

  const rows = archiveQ.data?.rows ?? [];
  const rowsByYear = new Map<number, MonthlyMvpArchiveRow[]>();

  rows.forEach((row) => {
    const yearRows = rowsByYear.get(row.school_year) ?? [];
    yearRows.push(row);
    rowsByYear.set(row.school_year, yearRows);
  });

  const awardCounts = rows.reduce<Map<string, number>>((acc, row) => {
    acc.set(row.winner_display_name, (acc.get(row.winner_display_name) ?? 0) + 1);
    return acc;
  }, new Map());

  const mostAwards = Math.max(0, ...Array.from(awardCounts.values()));
  const leaders = Array.from(awardCounts.entries())
    .filter(([, count]) => count === mostAwards && count > 0)
    .map(([name]) => name);

  return (
    <div className="space-y-6">
      <style>{MVP_GALLERY_STYLE}</style>

      <ArchiveEntrance
        rowsByYear={rowsByYear}
        leaders={leaders}
        mostAwards={mostAwards}
      />

      {archiveQ.isLoading ? (
        <div className="flex flex-col items-center gap-3 py-16 text-text-muted">
          <LoadingSpinner size="lg" />
          <div className="text-sm font-bold">월간 MVP 전시 기록을 불러오고 있어요.</div>
        </div>
      ) : archiveQ.isError ? (
        <Feature4ErrorPanel domain="F4D" error={archiveQ.error} onRetry={() => void archiveQ.refetch()} />
      ) : (
        <div className="space-y-8">
          <YearGallery
            year={2023}
            rows={rowsByYear.get(2023) ?? []}
          />

          {renderGapBetween(
            2023,
            2026,
            archiveQ.data?.gap_eras ?? [],
          )}

          <YearGallery
            year={2026}
            rows={rowsByYear.get(2026) ?? []}
          />
        </div>
      )}
    </div>
  );
}

function ArchiveEntrance({
  rowsByYear,
  leaders,
  mostAwards,
}: {
  rowsByYear: Map<number, MonthlyMvpArchiveRow[]>;
  leaders: string[];
  mostAwards: number;
}) {
  return (
    <section className="relative overflow-hidden rounded-[30px] border border-amber-200/20 bg-[radial-gradient(circle_at_15%_0%,rgba(255,211,118,0.11),transparent_32%),radial-gradient(circle_at_90%_18%,rgba(141,165,255,0.10),transparent_28%),linear-gradient(180deg,rgba(20,18,29,0.98),rgba(9,9,17,0.995))] px-5 py-7 shadow-[0_24px_68px_rgba(0,0,0,0.28)] sm:px-7 sm:py-8">
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-[-135px] h-[300px] w-[720px] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(255,220,144,0.12),transparent_68%)] blur-2xl"
      />

      <div className="relative">
        <div className="mx-auto max-w-3xl text-center">
          <div className="text-[10px] font-black tracking-[0.28em] text-amber-200/78">
            B.R.A.N.D · MONTHLY MVP PORTRAIT GALLERY
          </div>
          <h2
            className="records-mvp-serif mt-2 bg-[linear-gradient(180deg,#fff8df_0%,#ffe9aa_24%,#fff8e9_48%,#d6af62_76%,#fff2c3_100%)] bg-clip-text text-[clamp(2rem,4vw,3.2rem)] font-black tracking-[-0.045em] text-transparent [word-break:keep-all]"
            style={{
              textShadow:
                '0 1px 0 rgba(255,248,220,0.38), 0 2px 0 rgba(147,103,18,0.18), 0 10px 24px rgba(0,0,0,0.42), 0 0 16px rgba(255,216,132,0.10)',
            }}
          >
            월간 MVP
          </h2>
          <p className="records-mvp-serif mx-auto mt-3 max-w-2xl text-sm font-bold leading-7 text-amber-50/82 [word-break:keep-all] sm:text-[0.98rem]">
            한 달의 왕관을 쓴 사람과, 끝까지 그 왕관을 다퉜던 이름들을 함께 조명합니다.
          </p>
        </div>

        <div className="mt-6 grid gap-3 sm:grid-cols-2">
          {DISPLAY_YEARS.map((year) => {
            const count = rowsByYear.get(year)?.length ?? 0;
            const is2026 = year === 2026;

            return (
              <a
                key={year}
                href={`#monthly-mvp-${year}`}
                className={[
                  'group relative overflow-hidden rounded-[22px] border px-4 py-4 transition duration-200 hover:-translate-y-0.5',
                  is2026
                    ? 'border-sky-200/20 bg-[linear-gradient(135deg,rgba(58,79,130,0.20),rgba(11,13,25,0.78))] hover:border-sky-100/34'
                    : 'border-amber-200/20 bg-[linear-gradient(135deg,rgba(116,78,41,0.18),rgba(18,13,17,0.80))] hover:border-amber-100/34',
                ].join(' ')}
              >
                <div
                  aria-hidden="true"
                  className={[
                    'absolute -right-8 -top-10 h-28 w-28 rounded-full blur-2xl transition group-hover:opacity-90',
                    is2026 ? 'bg-sky-300/10' : 'bg-amber-300/10',
                  ].join(' ')}
                />

                <div className="relative flex items-center justify-between gap-4">
                  <div>
                    <div className={[
                      'text-[9px] font-black tracking-[0.22em]',
                      is2026 ? 'text-sky-100/64' : 'text-amber-200/64',
                    ].join(' ')}>
                      PORTRAIT WING
                    </div>
                    <div className="records-mvp-serif mt-1 text-2xl font-black text-white">
                      {year} 전시관
                    </div>
                    <div className="mt-1 text-xs font-bold text-white/55">
                      공식 월간 MVP {count}개 기록
                    </div>
                  </div>

                  <div className={[
                    'flex h-12 w-12 shrink-0 items-center justify-center rounded-full border',
                    is2026
                      ? 'border-sky-100/24 bg-sky-100/[0.05] text-sky-100'
                      : 'border-amber-100/24 bg-amber-100/[0.05] text-amber-100',
                  ].join(' ')}>
                    <Crown className="h-5 w-5" strokeWidth={1.45} />
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {mostAwards > 0 && (
          <div className="mx-auto mt-4 flex max-w-xl items-center justify-center gap-3 rounded-full border border-amber-100/14 bg-black/18 px-4 py-2 text-center">
            <Sparkles className="h-4 w-4 shrink-0 text-amber-200/70" strokeWidth={1.5} />
            <div className="text-[11px] font-bold text-white/62 [word-break:keep-all]">
              현재 아카이브 최다 수상 · <span className="font-black text-amber-100">{leaders.join(' · ')}</span>
              <span className="ml-1.5 text-amber-200">{mostAwards}회</span>
            </div>
          </div>
        )}
      </div>
    </section>
  );
}

function YearGallery({
  year,
  rows,
}: {
  year: 2023 | 2026;
  rows: MonthlyMvpArchiveRow[];
}) {
  const sorted = [...rows].sort((a, b) => a.month_no - b.month_no);
  const is2026 = year === 2026;

  return (
    <section
      id={`monthly-mvp-${year}`}
      className={[
        'scroll-mt-24 overflow-hidden rounded-[30px] border shadow-[0_26px_72px_rgba(0,0,0,0.26)]',
        is2026
          ? 'border-sky-200/18 bg-[radial-gradient(circle_at_88%_0%,rgba(102,143,230,0.13),transparent_32%),linear-gradient(180deg,rgba(15,20,34,0.98),rgba(7,9,17,1))]'
          : 'border-amber-200/18 bg-[radial-gradient(circle_at_12%_0%,rgba(195,132,65,0.13),transparent_32%),linear-gradient(180deg,rgba(31,22,20,0.98),rgba(12,10,15,1))]',
      ].join(' ')}
    >
      <YearGalleryHeader year={year} count={sorted.length} />

      {sorted.length > 0 ? (
        <div className="grid gap-5 p-4 sm:p-6 lg:grid-cols-2">
          {sorted.map((row, index) => (
            <MvpPortraitShowcase
              key={row.period_key}
              row={row}
              year={year}
              index={index}
            />
          ))}
        </div>
      ) : (
        <div className="p-5 sm:p-7">
          <div className="flex min-h-[230px] flex-col items-center justify-center rounded-[24px] border border-dashed border-white/14 bg-black/18 px-6 text-center">
            <Crown className={is2026 ? 'h-10 w-10 text-sky-100/42' : 'h-10 w-10 text-amber-100/42'} strokeWidth={1.25} />
            <div className="records-mvp-serif mt-4 text-xl font-black text-white/84">
              전시 기록을 기다리고 있습니다
            </div>
            <div className="mt-2 text-xs font-bold text-white/48">
              공식 월간 MVP 기록이 등록되면 이 전시관에 조명됩니다.
            </div>
          </div>
        </div>
      )}
    </section>
  );
}

function YearGalleryHeader({
  year,
  count,
}: {
  year: 2023 | 2026;
  count: number;
}) {
  const is2026 = year === 2026;

  return (
    <header className={[
      'relative overflow-hidden border-b px-5 py-5 sm:px-7 sm:py-6',
      is2026 ? 'border-sky-100/12' : 'border-amber-100/12',
    ].join(' ')}>
      <div
        aria-hidden="true"
        className={[
          'absolute left-1/2 top-[-120px] h-[230px] w-[560px] -translate-x-1/2 rounded-full blur-2xl',
          is2026 ? 'bg-sky-200/[0.07]' : 'bg-amber-200/[0.07]',
        ].join(' ')}
      />

      <div className="relative flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <div className={[
            'text-[10px] font-black tracking-[0.24em]',
            is2026 ? 'text-sky-100/64' : 'text-amber-200/64',
          ].join(' ')}>
            {year} · MONTHLY MVP PORTRAIT WING
          </div>
          <h3 className="records-mvp-serif mt-1 text-[clamp(1.65rem,3.5vw,2.4rem)] font-black tracking-[-0.04em] text-white [word-break:keep-all]">
            {year} 월간 MVP 전시관
          </h3>
          <p className="mt-2 text-xs font-bold leading-6 text-white/56 [word-break:keep-all] sm:text-sm">
            {is2026
              ? '월별 최종 수상자를 초상과 함께 전시하고, 그 달의 공식 본선 대적자를 함께 기록합니다.'
              : '2023년 월별 최종 수상자와 그 달의 공식 본선 대적자를 함께 보존합니다.'}
          </p>
        </div>

        <div className={[
          'w-fit rounded-full border px-3 py-1.5 text-[10px] font-black',
          is2026
            ? 'border-sky-100/18 bg-sky-100/[0.04] text-sky-100/72'
            : 'border-amber-100/18 bg-amber-100/[0.04] text-amber-100/72',
        ].join(' ')}>
          {count} PRESERVED CROWNS
        </div>
      </div>
    </header>
  );
}

function MvpPortraitShowcase({
  row,
  year,
  index,
}: {
  row: MonthlyMvpArchiveRow;
  year: 2023 | 2026;
  index: number;
}) {
  const incarnation = resolveIncarnation(row);

  if (!incarnation) {
    return <LegacyMvpPortraitShowcase row={row} year={year} index={index} />;
  }

  const theme = MVP_ARCHIVE_THEMES[incarnation.themeKey];
  const portrait = resolvePortrait(row);
  const rivals = resolveRivals(row).slice(0, 3);
  const titleLength = Array.from(incarnation.title.replace(/\s+/g, '')).length;
  const incarnationTitleSizeClass = titleLength >= 8
    ? 'text-[clamp(1.02rem,1.55vw,1.34rem)] tracking-[-0.075em]'
    : titleLength >= 7
      ? 'text-[clamp(1.12rem,1.72vw,1.48rem)] tracking-[-0.068em]'
      : 'text-[clamp(1.22rem,1.92vw,1.62rem)] tracking-[-0.058em]';

  const premiumStyle = {
    '--mvp-bg': theme.background,
    '--mvp-panel': theme.panel,
    '--mvp-primary': theme.primary,
    '--mvp-secondary': theme.secondary,
    '--mvp-accent': theme.accent,
    '--mvp-border': theme.border,
    '--mvp-glow': theme.glow,
    '--mvp-soft-glow': theme.softGlow,
    '--mvp-particle': theme.particle,
  } as CSSProperties;

  return (
    <article
      data-mvp-theme={incarnation.themeKey}
      className="records-mvp-premium records-mvp-premium-v4 records-mvp-premium-v5 records-mvp-premium-v6 relative isolate overflow-hidden rounded-[26px] border p-3.5 sm:p-4"
      style={premiumStyle}
    >
      <div aria-hidden="true" className="records-mvp-v5-corner records-mvp-v5-corner-tl">⌜</div>
      <div aria-hidden="true" className="records-mvp-v5-corner records-mvp-v5-corner-tr">⌝</div>
      <div aria-hidden="true" className="records-mvp-v5-corner records-mvp-v5-corner-bl">⌞</div>
      <div aria-hidden="true" className="records-mvp-v5-corner records-mvp-v5-corner-br">⌟</div>

      <div className="relative z-[2]">
        <div className="flex items-start justify-between gap-3">
          <div>
            <div
              className="records-mvp-serif text-[13px] font-black tracking-[0.16em] sm:text-[15px]"
              style={{ color: theme.accent }}
            >
              {year} · {row.month_no}월
            </div>
            <div className="mt-0.5 text-[7px] font-black tracking-[0.24em] text-white/52 sm:text-[8px]">MONTHLY MVP</div>
          </div>

          <div className="text-right">
            <div className="text-[9px] font-black tracking-[0.28em] text-white/78 sm:text-[10px]">B · R · A · N · D</div>
            <div className="mt-0.5 text-[6px] font-black tracking-[0.24em] text-white/42 sm:text-[7px]">OFFICIAL ARCHIVE</div>
          </div>
        </div>

        <div className="mt-3 grid gap-4 sm:grid-cols-[minmax(150px,0.86fr)_minmax(0,1.14fr)] sm:items-center">
          <PortraitStage row={row} portrait={portrait} year={year} />

          <div className="min-w-0 py-0 sm:py-1">
            <section className="text-center">
              <div className="flex items-center justify-center gap-2">
                <span className="h-px w-8" style={{ backgroundImage: `linear-gradient(to right, transparent, ${theme.secondary})` }} />
                <span className="text-[8px] font-black tracking-[0.16em] text-white/78 sm:text-[9px]">최종 수상</span>
                <span className="h-px w-8" style={{ backgroundImage: `linear-gradient(to left, transparent, ${theme.secondary})` }} />
              </div>
              <Crown
                className="mx-auto mt-1 h-4 w-4"
                style={{ color: theme.accent, filter: `drop-shadow(0 0 7px ${theme.glow})` }}
                strokeWidth={1.35}
              />
              <div
                className="records-mvp-serif mt-1 whitespace-nowrap text-[clamp(1.72rem,3.05vw,2.28rem)] font-black leading-none tracking-[-0.05em]"
                style={{ color: '#fff2cf', textShadow: `0 7px 18px rgba(0,0,0,.50), 0 0 12px ${theme.softGlow}` }}
              >
                {row.winner_display_name}
              </div>
            </section>

            <div className="my-2 flex items-center gap-2" aria-hidden="true">
              <span className="h-px flex-1" style={{ backgroundImage: `linear-gradient(to right, transparent, ${theme.secondary})` }} />
              <span className="records-mvp-v5-ornament text-[10px]" style={{ color: theme.accent }}>{incarnation.motif}</span>
              <span className="h-px flex-1" style={{ backgroundImage: `linear-gradient(to left, transparent, ${theme.secondary})` }} />
            </div>

            <section className="records-mvp-incarnation-stage-v6 relative flex min-h-[96px] min-w-0 flex-col items-center justify-center overflow-hidden px-1 py-2 text-center sm:min-h-[102px]">
              <div aria-hidden="true" className="records-mvp-v6-theme-art" />
              <div aria-hidden="true" className="records-mvp-v6-theme-mark">{incarnation.motif}</div>

              <div className="relative z-[2] flex items-center gap-2">
                <span className="records-mvp-v6-label-line" />
                <div
                  className="rounded-full border px-2.5 py-1 text-[7px] font-black tracking-[0.16em] text-white/78 sm:text-[8px]"
                  style={{ borderColor: theme.border, background: 'rgba(0,0,0,.23)' }}
                >
                  탄생 화신
                </div>
                <span className="records-mvp-v6-label-line" />
              </div>

              <div
                className={`records-mvp-incarnation-title-v6 records-mvp-serif relative z-[2] mt-2 max-w-full whitespace-nowrap bg-clip-text font-black leading-none text-transparent ${incarnationTitleSizeClass}`}
                style={{ backgroundImage: theme.titleGradient, textShadow: '0 6px 16px rgba(0,0,0,.46)' }}
              >
                {incarnation.title}
              </div>
            </section>

            <section className="mt-2.5">
              <div className="mb-1.5 flex items-center justify-center gap-1.5">
                <UsersRound className="h-3.5 w-3.5" style={{ color: theme.accent }} strokeWidth={1.35} />
                <div className="text-[8px] font-black tracking-[0.10em] text-white/78 sm:text-[9px]">그 달의 대적자</div>
              </div>

              {rivals.length > 0 ? (
                <div
                  className="mx-auto grid w-full max-w-[300px] gap-1.5"
                  style={{ gridTemplateColumns: `repeat(${rivals.length}, minmax(0, 1fr))` }}
                >
                  {rivals.map((name) => (
                    <div
                      key={`${row.period_key}-${name}`}
                      className="records-mvp-v6-rival min-w-0 rounded-[10px] border px-1.5 py-1.5 text-center"
                      style={{ borderColor: theme.border }}
                    >
                      <div className="records-mvp-serif truncate text-[10px] font-extrabold text-white/88 sm:text-[11px]">{name}</div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="rounded-[10px] border border-dashed border-white/10 bg-black/16 px-2 py-2 text-center text-[9px] font-bold text-white/34">
                  공식 본선 대적자 기록 없음
                </div>
              )}
            </section>
          </div>
        </div>

        <div className="mt-2.5 flex items-center justify-center gap-2.5 text-center text-[7px] font-black tracking-[0.16em] text-white/34 sm:text-[8px]">
          <span className="h-px w-10" style={{ backgroundImage: `linear-gradient(to right, transparent, ${theme.secondary})` }} />
          OFFICIAL MONTHLY MVP ARCHIVE · {String(index + 1).padStart(2, '0')}
          <span className="h-px w-10" style={{ backgroundImage: `linear-gradient(to left, transparent, ${theme.secondary})` }} />
        </div>
      </div>
    </article>
  );
}

function LegacyMvpPortraitShowcase({
  row,
  year,
  index,
}: {
  row: MonthlyMvpArchiveRow;
  year: 2023 | 2026;
  index: number;
}) {
  const rivals = resolveRivals(row);
  const portrait = resolvePortrait(row);
  const is2026 = year === 2026;

  const accent = portrait?.accent ?? (is2026 ? 'silver' : 'gold');
  const accentClass = {
    silver: {
      border: 'border-slate-200/22',
      line: 'via-slate-100/46',
      glow: 'rgba(188,214,238,0.20)',
      light: 'rgba(188,214,238,0.16)',
      text: 'text-slate-100',
    },
    gold: {
      border: 'border-amber-100/24',
      line: 'via-amber-100/50',
      glow: 'rgba(255,203,102,0.22)',
      light: 'rgba(255,203,102,0.17)',
      text: 'text-amber-100',
    },
    rose: {
      border: 'border-rose-200/22',
      line: 'via-rose-100/46',
      glow: 'rgba(251,146,175,0.20)',
      light: 'rgba(251,146,175,0.15)',
      text: 'text-rose-100',
    },
    cyan: {
      border: 'border-cyan-100/22',
      line: 'via-cyan-100/46',
      glow: 'rgba(125,231,239,0.19)',
      light: 'rgba(125,231,239,0.15)',
      text: 'text-cyan-100',
    },
  }[accent];

  return (
    <article className={[
      'records-mvp-showcase relative isolate overflow-hidden rounded-[26px] border bg-[linear-gradient(180deg,rgba(17,17,27,0.82),rgba(7,8,15,0.94))] p-3.5 sm:p-4',
      accentClass.border,
    ].join(' ')}>
      <div
        aria-hidden="true"
        className="records-mvp-light pointer-events-none absolute left-1/2 top-[-112px] h-[260px] w-[240px] -translate-x-1/2 rounded-[50%]"
        style={{
          background: `radial-gradient(ellipse, ${accentClass.light} 0%, transparent 70%)`,
          filter: 'blur(14px)',
        }}
      />
      <div
        aria-hidden="true"
        className="pointer-events-none absolute bottom-[-70px] left-1/2 h-[150px] w-[76%] -translate-x-1/2 rounded-[50%]"
        style={{
          background: `radial-gradient(ellipse, ${accentClass.glow} 0%, transparent 68%)`,
          filter: 'blur(18px)',
        }}
      />
      <div
        aria-hidden="true"
        className={`pointer-events-none absolute inset-x-[12%] top-0 h-px bg-gradient-to-r from-transparent ${accentClass.line} to-transparent`}
      />

      <div className="relative">
        <div className="flex items-center justify-between gap-3">
          <div className={[
            'text-[10px] font-black tracking-[0.18em]',
            accentClass.text,
          ].join(' ')}>
            {year} · {row.month_no}월
          </div>
          <div className="rounded-full border border-white/12 bg-black/22 px-2.5 py-1 text-[9px] font-black tracking-[0.12em] text-white/58">
            MONTHLY MVP
          </div>
        </div>

        <div className="mt-3 grid gap-4 sm:grid-cols-[minmax(150px,0.86fr)_minmax(0,1.14fr)] sm:items-center">
          <PortraitStage
            row={row}
            portrait={portrait}
            year={year}
          />

          <div className="min-w-0 py-1 sm:py-3">
            <div className="text-[10px] font-black tracking-[0.18em] text-amber-100/74">
              최종 수상
            </div>
            <div
              className="records-mvp-serif mt-1.5 whitespace-nowrap text-[clamp(1.7rem,4.4vw,2.45rem)] font-black leading-none tracking-[-0.045em]"
              style={{
                color: '#fff0c8',
                textShadow: `0 2px 0 rgba(172,113,37,.20), 0 8px 20px rgba(0,0,0,.50), 0 16px 28px ${accentClass.glow}`,
              }}
            >
              {row.winner_display_name}
            </div>

            <div className="mt-3 flex items-center gap-2" aria-hidden="true">
              <span className={`h-px flex-1 bg-gradient-to-r from-transparent ${accentClass.line}`} />
              <Crown className={`h-4 w-4 ${accentClass.text}`} strokeWidth={1.35} />
              <span className={`h-px flex-1 bg-gradient-to-l from-transparent ${accentClass.line}`} />
            </div>

            <div className="mt-4">
              <div className="flex items-center gap-2">
                <UsersRound className="h-4 w-4 text-amber-100/68" strokeWidth={1.45} />
                <div className="text-[10px] font-black tracking-[0.12em] text-amber-50/82">
                  그 달의 대적자
                </div>
              </div>

              {rivals.length > 0 ? (
                <div className="mt-2 grid grid-cols-2 gap-2">
                  {rivals.map((name) => (
                    <div
                      key={`${row.period_key}-${name}`}
                      className="min-w-0 rounded-[14px] border border-white/11 bg-black/24 px-2.5 py-2 text-center"
                    >
                      <div className="records-mvp-serif whitespace-nowrap text-[13px] font-extrabold text-white/86 sm:text-sm">
                        {name}
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div className="mt-2 rounded-[14px] border border-dashed border-white/10 bg-black/16 px-3 py-3 text-center text-[10px] font-bold text-white/34">
                  공식 본선 대적자 기록 없음
                </div>
              )}
            </div>
          </div>
        </div>

        <div className="mt-3 text-center text-[9px] font-black tracking-[0.16em] text-white/28">
          OFFICIAL MONTHLY MVP ARCHIVE · {String(index + 1).padStart(2, '0')}
        </div>
      </div>
    </article>
  );
}


function resolveIncarnation(row: MonthlyMvpArchiveRow): IncarnationSpec | null {
  if (row.school_year !== 2026) return null;

  const fallback = INCARNATIONS_2026[row.month_no];
  if (!fallback) return null;

  const metadataTitle = readMetadataString(row.metadata, ['incarnation_title']);
  const metadataTheme = readMetadataString(row.metadata, ['incarnation_theme']);
  const themeKey = metadataTheme && metadataTheme in MVP_ARCHIVE_THEMES
    ? metadataTheme as IncarnationThemeKey
    : fallback.themeKey;

  return {
    ...fallback,
    title: metadataTitle ?? fallback.title,
    themeKey,
  };
}

function resolveRivalPortraits(row: MonthlyMvpArchiveRow): Record<string, string> {
  const value = row.metadata.rival_portraits;
  if (!value || typeof value !== 'object' || Array.isArray(value)) return {};

  return Object.entries(value as Record<string, unknown>).reduce<Record<string, string>>((acc, [name, url]) => {
    if (typeof url === 'string' && url.trim()) acc[name] = url.trim();
    return acc;
  }, {});
}

function ThemeAtmosphere({ incarnation }: { incarnation: IncarnationSpec }) {
  const positions = [
    ['12%', '82%'], ['22%', '34%'], ['42%', '76%'], ['58%', '18%'],
    ['70%', '84%'], ['82%', '28%'], ['91%', '68%'], ['64%', '56%'],
  ];

  return (
    <div className="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div className="records-mvp-sigil"><span className="records-mvp-sigil-mark">{incarnation.motif}</span></div>
      {positions.map(([left, top], index) => (
        <span
          key={`${incarnation.themeKey}-particle-${index}`}
          className="records-mvp-particle"
          style={{ left, top, animationDelay: `${-index * 0.73}s` }}
        />
      ))}
      <span className="records-mvp-ornament absolute left-4 top-3 text-[13px]">⌜</span>
      <span className="records-mvp-ornament absolute right-4 top-3 text-[13px]">⌝</span>
      <span className="records-mvp-ornament absolute bottom-3 left-4 text-[13px]">⌞</span>
      <span className="records-mvp-ornament absolute bottom-3 right-4 text-[13px]">⌟</span>
    </div>
  );
}

function PremiumPortraitStage({
  row,
  portrait,
}: {
  row: MonthlyMvpArchiveRow;
  portrait: PortraitSpec | null;
}) {
  if (!portrait) {
    return (
      <div className="relative flex min-h-[300px] items-center justify-center overflow-hidden rounded-t-[120px] rounded-b-[20px] border border-white/16 bg-black/35">
        <ImageOff className="h-9 w-9 text-white/32" strokeWidth={1.2} />
      </div>
    );
  }

  return (
    <div className="relative min-h-[300px] overflow-hidden rounded-t-[120px] rounded-b-[20px] border border-white/20 bg-black/50 shadow-[0_20px_44px_rgba(0,0,0,.36)] sm:min-h-[345px]">
      <img
        src={portrait.imageUrl}
        alt={`${row.period_label} 월간 MVP ${row.winner_display_name} 화신`}
        className="absolute inset-0 h-full w-full object-cover"
        style={{ objectPosition: portrait.objectPosition ?? '50% 50%', transform: portrait.scale ? `scale(${portrait.scale})` : undefined }}
        loading="lazy"
      />
      <div className="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,.12),transparent_45%,rgba(0,0,0,.34))]" />
      <div className="absolute inset-[7px] rounded-t-[112px] rounded-b-[14px] border border-white/[0.09]" />
      <div className="absolute inset-x-[12%] bottom-0 h-px bg-gradient-to-r from-transparent via-white/46 to-transparent" />
    </div>
  );
}

function PremiumRivalCard({
  name,
  imageUrl,
  theme,
}: {
  name: string;
  imageUrl?: string;
  theme: MvpArchiveTheme;
}) {
  return (
    <div className="records-mvp-rival-tile min-w-0 overflow-hidden rounded-[12px] border">
      <div className="relative aspect-[1.7/1] overflow-hidden">
        {imageUrl ? (
          <img src={imageUrl} alt="" className="h-full w-full object-cover" loading="lazy" />
        ) : (
          <div className="records-mvp-rival-placeholder flex h-full items-center justify-center">
            <span
              className="records-mvp-serif text-xl font-black"
              style={{ color: theme.accent, textShadow: `0 0 12px ${theme.glow}` }}
            >
              {name.slice(0, 1)}
            </span>
          </div>
        )}
        <div className="absolute inset-0 bg-gradient-to-t from-black/58 via-transparent to-transparent" />
      </div>
      <div className="records-mvp-serif truncate px-1.5 py-1.5 text-center text-[11px] font-extrabold text-white/90 sm:text-xs">{name}</div>
    </div>
  );
}
function ThemeAtmosphereV4({ incarnation }: { incarnation: IncarnationSpec }) {
  const positions = [
    ['8%', '82%'], ['16%', '27%'], ['29%', '72%'], ['48%', '17%'],
    ['66%', '82%'], ['78%', '24%'], ['91%', '64%'], ['64%', '53%'],
  ];

  return (
    <div className="pointer-events-none absolute inset-0 z-0 overflow-hidden" aria-hidden="true">
      <div className="records-mvp-sigil records-mvp-sigil-v4"><span className="records-mvp-sigil-mark">{incarnation.motif}</span></div>
      {positions.map(([left, top], index) => (
        <span
          key={`${incarnation.themeKey}-particle-v4-${index}`}
          className="records-mvp-particle records-mvp-particle-v4"
          style={{ left, top, animationDelay: `${-index * 0.73}s` }}
        />
      ))}
      <span className="records-mvp-ornament absolute left-4 top-3 text-[13px]">⌜</span>
      <span className="records-mvp-ornament absolute right-4 top-3 text-[13px]">⌝</span>
      <span className="records-mvp-ornament absolute bottom-3 left-4 text-[13px]">⌞</span>
      <span className="records-mvp-ornament absolute bottom-3 right-4 text-[13px]">⌟</span>
    </div>
  );
}

function PremiumPortraitStageV4({
  row,
  portrait,
  theme,
}: {
  row: MonthlyMvpArchiveRow;
  portrait: PortraitSpec | null;
  theme: MvpArchiveTheme;
}) {
  if (!portrait) {
    return (
      <div className="relative mx-auto flex aspect-[4/5] w-full max-w-[480px] items-center justify-center overflow-hidden rounded-t-[152px] rounded-b-[26px] border border-white/16 bg-black/35">
        <ImageOff className="h-10 w-10 text-white/32" strokeWidth={1.2} />
      </div>
    );
  }

  const localFallback = `/records/mvp/2026/${row.month_no === 9 ? 'September_MVP' : ({3:'March_MVP',4:'April_MVP',5:'May_MVP',6:'June_MVP',7:'July_MVP'} as Record<number,string>)[row.month_no] ?? 'March_MVP'}.webp`;

  return (
    <div
      className="records-mvp-portrait-shell records-mvp-portrait-shell-v4 relative mx-auto aspect-[4/5] w-full max-w-[480px] overflow-hidden rounded-t-[152px] rounded-b-[26px] border bg-black/50 shadow-[0_24px_54px_rgba(0,0,0,.42)]"
      style={{ borderColor: theme.border }}
    >
      <img
        src={portrait.imageUrl}
        alt={`${row.period_label} 월간 MVP ${row.winner_display_name} 화신`}
        className="absolute inset-0 h-full w-full object-cover"
        style={{
          objectPosition: portrait.objectPosition ?? '50% 50%',
          transform: portrait.scale ? `scale(${portrait.scale})` : undefined,
        }}
        onError={(event) => {
          const image = event.currentTarget;
          if (image.dataset.fallbackApplied === '1') {
            image.style.display = 'none';
            return;
          }
          image.dataset.fallbackApplied = '1';
          image.src = localFallback;
        }}
        loading="lazy"
      />
      <div className="absolute inset-0 bg-[linear-gradient(180deg,rgba(0,0,0,.08),transparent_44%,rgba(0,0,0,.30))]" />
      <div className="absolute inset-[8px] rounded-t-[144px] rounded-b-[18px] border border-white/[0.10]" />
      <div className="absolute inset-x-[8%] bottom-0 h-px bg-gradient-to-r from-transparent via-white/54 to-transparent" />
      <div className="records-mvp-portrait-light absolute inset-x-[12%] bottom-[-8%] h-[25%] rounded-[50%]" style={{ background: `radial-gradient(ellipse, ${theme.softGlow}, transparent 72%)` }} />
    </div>
  );
}

function PremiumRivalCardV4({
  name,
  imageUrl,
  theme,
  motif,
}: {
  name: string;
  imageUrl?: string;
  theme: MvpArchiveTheme;
  motif: string;
}) {
  return (
    <div className="records-mvp-rival-tile records-mvp-rival-tile-v4 min-w-0 overflow-hidden rounded-[14px] border">
      {imageUrl ? (
        <div className="relative h-[72px] overflow-hidden sm:h-[84px]">
          <img src={imageUrl} alt="" className="h-full w-full object-cover" loading="lazy" />
          <div className="absolute inset-0 bg-gradient-to-t from-black/68 via-black/8 to-transparent" />
        </div>
      ) : (
        <div className="records-mvp-rival-placeholder records-mvp-rival-placeholder-v4 flex h-[50px] items-center justify-center sm:h-[58px]">
          <span
            className="records-mvp-rival-medallion flex h-7 w-7 items-center justify-center rounded-full border text-[11px] font-black sm:h-8 sm:w-8 sm:text-xs"
            style={{ borderColor: theme.border, color: theme.accent, boxShadow: `0 0 14px ${theme.softGlow}` }}
          >
            {motif}
          </span>
        </div>
      )}
      <div className="records-mvp-serif truncate border-t border-white/[0.06] px-2 py-2 text-center text-[12px] font-extrabold text-white/92 sm:text-[13px]">{name}</div>
    </div>
  );
}

function resolveRivals(row: MonthlyMvpArchiveRow) {
  const override = RIVAL_ORDER_OVERRIDES[`${row.school_year}-${row.month_no}`];
  if (override) return override;

  return row.finalists.filter((name) => name !== row.winner_display_name);
}

function PortraitStage({
  row,
  portrait,
  year,
}: {
  row: MonthlyMvpArchiveRow;
  portrait: PortraitSpec | null;
  year: 2023 | 2026;
}) {
  if (!portrait) {
    return (
      <div className="relative mx-auto w-full max-w-[230px]">
        <div
          aria-hidden="true"
          className="absolute left-1/2 top-[-36px] h-[130px] w-[150px] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(ellipse,rgba(255,213,130,0.11),transparent_70%)] blur-xl"
        />
        <div className="relative aspect-[9/13] overflow-hidden rounded-t-[92px] rounded-b-[24px] border border-amber-100/20 bg-[radial-gradient(circle_at_50%_22%,rgba(255,219,146,0.08),transparent_34%),linear-gradient(180deg,rgba(39,29,27,0.78),rgba(8,8,14,0.92))] shadow-[inset_0_0_40px_rgba(255,217,145,0.025),0_18px_34px_rgba(0,0,0,0.30)]">
          <div className="absolute inset-[8px] rounded-t-[84px] rounded-b-[18px] border border-amber-100/[0.07]" />
          <div className="flex h-full flex-col items-center justify-center px-4 text-center">
            <div className="flex h-16 w-16 items-center justify-center rounded-full border border-amber-100/18 bg-black/22 text-amber-100/52 shadow-[0_0_24px_rgba(255,211,119,0.08)]">
              <ImageOff className="h-7 w-7" strokeWidth={1.25} />
            </div>
            <div className="records-mvp-serif mt-4 text-sm font-extrabold text-amber-50/72">
              {year} 초상 전시 자리
            </div>
            <div className="mt-1.5 text-[9px] font-black tracking-[0.16em] text-amber-100/34">
              PORTRAIT RESERVED
            </div>
          </div>
          <div
            aria-hidden="true"
            className="absolute inset-x-[16%] bottom-0 h-px bg-gradient-to-r from-transparent via-amber-100/34 to-transparent"
          />
        </div>
      </div>
    );
  }

  return (
    <div className="relative mx-auto w-full max-w-[230px]">
      <div
        aria-hidden="true"
        className="absolute left-1/2 top-[-34px] h-[130px] w-[160px] -translate-x-1/2 rounded-[50%] bg-[radial-gradient(ellipse,rgba(255,232,176,0.13),transparent_70%)] blur-xl"
      />
      <div
        className="relative aspect-[9/13] overflow-hidden rounded-t-[92px] rounded-b-[24px] border border-white/18 bg-black/60 shadow-[0_18px_36px_rgba(0,0,0,0.34)]"
        style={{
          clipPath: portrait.flip
            ? 'inset(0 round 92px 92px 24px 24px)'
            : undefined,
        }}
      >
        <img
          src={portrait.imageUrl}
          alt={`${row.period_label} 월간 MVP ${row.winner_display_name}`}
          className={[
            'h-full w-full',
            portrait.fit === 'cover' ? 'object-cover' : 'object-contain',
          ].join(' ')}
          style={{
            objectPosition: portrait.objectPosition ?? '50% 50%',
            transform:
              portrait.flip || portrait.scale
                ? `${portrait.flip ? 'scaleX(-1) ' : ''}scale(${portrait.scale ?? 1})`
                : undefined,
            transformOrigin: 'center',
          }}
          loading="lazy"
        />
        <div aria-hidden="true" className="absolute inset-x-0 top-0 h-[22%] bg-gradient-to-b from-black/38 to-transparent" />
        <div aria-hidden="true" className="absolute inset-x-0 bottom-0 h-[32%] bg-gradient-to-t from-black/66 via-black/16 to-transparent" />
        <div aria-hidden="true" className="absolute inset-[7px] rounded-t-[84px] rounded-b-[18px] border border-white/[0.07]" />
      </div>
    </div>
  );
}

function resolvePortrait(row: MonthlyMvpArchiveRow): PortraitSpec | null {
  const metadataUrl = readMetadataString(row.metadata, [
    'portrait_url',
    'image_url',
    'mvp_portrait_url',
  ]);

  if (metadataUrl) {
    return {
      imageUrl: metadataUrl,
      accent: 'gold',
    };
  }

  if (row.school_year === 2023) {
    return PORTRAITS_2023[row.winner_display_name] ?? null;
  }

  if (row.school_year === 2026) {
    return PORTRAITS_2026[String(row.month_no)] ?? null;
  }

  return null;
}

function readMetadataString(
  metadata: Record<string, unknown>,
  keys: string[],
) {
  for (const key of keys) {
    const value = metadata[key];
    if (typeof value === 'string' && value.trim()) return value.trim();
  }
  return null;
}

function renderGapBetween(
  startYear: number,
  endYear: number,
  gaps: Array<{ start_year: number; end_year: number; title: string; subtitle: string }>,
) {
  const gap = gaps.find((item) => item.start_year > startYear && item.end_year < endYear);
  if (!gap) return null;

  return (
    <div
      key={`${gap.start_year}-${gap.end_year}`}
      className="relative overflow-hidden rounded-[24px] border border-dashed border-white/12 bg-[linear-gradient(180deg,rgba(12,12,20,0.86),rgba(7,8,14,0.92))] px-4 py-6 text-center"
    >
      <div aria-hidden="true" className="absolute inset-x-0 top-1/2 h-px bg-white/[0.06]" />
      <div className="relative mx-auto w-fit bg-[#0a0a12] px-6">
        <div className="text-[10px] font-black tracking-[0.20em] text-white/34">
          {gap.start_year}–{gap.end_year}
        </div>
        <div className="records-mvp-serif mt-1 text-xl font-black text-white/72">
          {gap.title}
        </div>
        <div className="mt-1 text-xs font-bold text-white/38 [word-break:keep-all]">
          {gap.subtitle}
        </div>
      </div>
    </div>
  );
}
