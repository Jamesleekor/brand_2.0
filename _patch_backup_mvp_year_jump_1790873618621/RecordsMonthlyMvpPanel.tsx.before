type PortraitSpec = {
  imageUrl: string;
  flip?: boolean;
  fit?: 'contain' | 'cover';
  scale?: number;
  objectPosition?: string;
  accent: 'silver' | 'gold' | 'rose' | 'cyan';
};

type IncarnationThemeKey =
  | 'DAWN_CALLER'
  | 'EMBER_CORE'
  | 'BLOOM_POTENTIAL'
  | 'PATHFINDER_TIDE'
  | 'PROCESSION_LINK'
  | 'AURORA_REBIRTH';

type IncarnationSpec = {
  title: string;
  themeKey: IncarnationThemeKey;
  motif: string;
};

type MvpArchiveTheme = {
  background: string;
  panel: string;
  primary: string;
  secondary: string;
  accent: string;
  border: string;
  glow: string;
  softGlow: string;
  particle: string;
  titleGradient: string;
};

