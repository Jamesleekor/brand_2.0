+-- ============================================================================
+-- 1. NEW GENERIC APPEND-ONLY AUDIT TABLES
+-- ============================================================================
+
+CREATE TABLE public.economy_guard_event_reviews (
+  id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+  classroom_id integer NOT NULL REFERENCES public.classrooms(id) ON DELETE CASCADE,
+  source_kind varchar(32) NOT NULL,
+  source_id bigint NOT NULL,
+  decision varchar(32) NOT NULL,
+  basis_hash varchar(32) NOT NULL,
+  event_snapshot jsonb NOT NULL DEFAULT '{}'::jsonb,
+  memo text,
+  reviewed_by_student_id integer REFERENCES public.students(id) ON DELETE SET NULL,
+  reviewed_by_user_id uuid NOT NULL,
+  guard_term_id integer REFERENCES public.guard_terms(id) ON DELETE SET NULL,
+  reviewed_at timestamptz NOT NULL DEFAULT now(),
+  created_at timestamptz NOT NULL DEFAULT now(),
+
+  CONSTRAINT economy_guard_event_reviews_source_kind_ck
+    CHECK (source_kind IN ('P2P_TRANSFER','SERVICE_ORDER')),
+  CONSTRAINT economy_guard_event_reviews_decision_ck
+    CHECK (decision IN ('NORMAL_CONFIRMED','FINAL_FLAGGED')),
+  CONSTRAINT economy_guard_event_reviews_basis_hash_ck
+    CHECK (basis_hash ~ '^[0-9a-f]{32}$'),
+  CONSTRAINT economy_guard_event_reviews_snapshot_ck
+    CHECK (jsonb_typeof(event_snapshot)='object'),
+  CONSTRAINT economy_guard_event_reviews_memo_ck
+    CHECK (char_length(coalesce(memo,'')) <= 500),
+  CONSTRAINT economy_guard_event_reviews_same_basis_uq
+    UNIQUE (classroom_id,source_kind,source_id,decision,basis_hash)
+);
+
+CREATE INDEX economy_guard_event_reviews_event_idx
+  ON public.economy_guard_event_reviews(classroom_id,source_kind,source_id,reviewed_at DESC,id DESC);
+
+CREATE INDEX economy_guard_event_reviews_guard_term_idx
+  ON public.economy_guard_event_reviews(guard_term_id)
+  WHERE guard_term_id IS NOT NULL;
+
+
+CREATE TABLE public.economy_guard_event_penalties (
+  id bigint GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
+  penalty_uid varchar(64) NOT NULL UNIQUE,
+  classroom_id integer NOT NULL REFERENCES public.classrooms(id) ON DELETE CASCADE,
+  source_kind varchar(32) NOT NULL,
+  source_id bigint NOT NULL,
+  subject_student_id integer NOT NULL REFERENCES public.students(id) ON DELETE RESTRICT,
+  reason varchar(64) NOT NULL,
+  memo text,
+  basis_hash varchar(32) NOT NULL,
+  event_snapshot jsonb NOT NULL DEFAULT '{}'::jsonb,
+  flagged_by_student_id integer REFERENCES public.students(id) ON DELETE SET NULL,
+  flagged_by_user_id uuid NOT NULL,
+  guard_term_id integer REFERENCES public.guard_terms(id) ON DELETE SET NULL,
+  created_at timestamptz NOT NULL DEFAULT now(),
+
+  CONSTRAINT economy_guard_event_penalties_source_kind_ck
+    CHECK (source_kind IN ('P2P_TRANSFER','SERVICE_ORDER')),
+  CONSTRAINT economy_guard_event_penalties_reason_ck
+    CHECK (reason IN ('사유 허위 기재','실물 거래 의심','강압적 거래','소명 거부','기타')),
+  CONSTRAINT economy_guard_event_penalties_basis_hash_ck
+    CHECK (basis_hash ~ '^[0-9a-f]{32}$'),
+  CONSTRAINT economy_guard_event_penalties_snapshot_ck
+    CHECK (jsonb_typeof(event_snapshot)='object'),
+  CONSTRAINT economy_guard_event_penalties_memo_ck
+    CHECK (char_length(coalesce(memo,'')) <= 500),
+  CONSTRAINT economy_guard_event_penalties_one_per_event_uq
+    UNIQUE (classroom_id,source_kind,source_id)
+);
+
+CREATE INDEX economy_guard_event_penalties_subject_idx
+  ON public.economy_guard_event_penalties(classroom_id,subject_student_id,created_at DESC);
+
+ALTER TABLE public.economy_guard_event_reviews ENABLE ROW LEVEL SECURITY;
+ALTER TABLE public.economy_guard_event_penalties ENABLE ROW LEVEL SECURITY;
+
+REVOKE ALL ON TABLE public.economy_guard_event_reviews FROM PUBLIC,anon,authenticated;
+REVOKE ALL ON TABLE public.economy_guard_event_penalties FROM PUBLIC,anon,authenticated;
+
+-- Direct browser DML is intentionally unavailable.
+-- service_role receives read-only direct visibility; guarded SECURITY DEFINER RPCs own writes.
+GRANT SELECT ON TABLE public.economy_guard_event_reviews TO service_role;
+GRANT SELECT ON TABLE public.economy_guard_event_penalties TO service_role;
