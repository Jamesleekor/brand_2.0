+++ b/supabase/applied_history/economy_guard_eg1_1_20260903/01_APPLIED_EG1_1_BASE.sql.applied
@@ -0,0 +1,2037 @@
+-- B.R.A.N.D 2.0
+-- Economy Guard EG1.1 — Focused One-Time Migration
+-- Date: 2026-09-03
+--
+-- IMPORTANT
+-- 1) DO NOT rerun historical EG1 migrations/hotfixes.
+-- 2) Run the separate ROLLBACK REHEARSAL first.
+-- 3) Run this APPLY only after the rehearsal passes.
+-- 4) This migration is intentionally fail-closed if the verified Production contract drifted.
+--
+-- Main changes:
+-- - Preserve original economy ledgers.
+-- - Add generic append-only Guard review / penalty audit tables.
+-- - Add canonical P2P + SERVICE_ORDER audit projection.
+-- - Exclude Live Test Agent / non-official participants server-side.
+-- - Prevent non-official students from becoming active Guards.
+-- - Keep legacy EG1 objects for rollback compatibility.
+-- - Do NOT alter GOLD/BV/wallets/source economic events.
+
+BEGIN;
+
+-- ============================================================================
+-- 0. FAIL-CLOSED PRODUCTION CONTRACT CHECK
+-- ============================================================================
+
+DO $eg11_precondition$
+DECLARE
+  v_hash text;
+BEGIN
+  IF to_regclass('public.p2p_transfers') IS NULL
+     OR to_regclass('public.secondary_job_service_orders') IS NULL
+     OR to_regclass('public.transactions') IS NULL
+     OR to_regclass('public.wallets') IS NULL
+     OR to_regclass('public.guard_terms') IS NULL THEN
+    RAISE EXCEPTION '[EG1.1] required source relation missing' USING ERRCODE='P8100';
+  END IF;
+
+  IF to_regprocedure('public.is_official_participant(integer)') IS NULL
+     OR to_regprocedure('public._economy_guard_assert_access()') IS NULL
+     OR to_regprocedure('public._economy_guard_period_bounds(text,date,date)') IS NULL
+     OR to_regprocedure('public.economy_guard_get_access()') IS NULL
+     OR to_regprocedure('public.teacher_appoint_guard(integer,integer,public.guard_role_type,date,date,text)') IS NULL THEN
+    RAISE EXCEPTION '[EG1.1] required helper/RPC missing' USING ERRCODE='P8101';
+  END IF;
+
+  -- Verified 2026-09-03 Production hashes. Refuse to overwrite silently if drifted.
+  SELECT md5(pg_get_functiondef(to_regprocedure('public._economy_guard_access_context()')))
+    INTO v_hash;
+  IF v_hash <> '9a8ea6304f362f33381b95dfd3b1c5e8' THEN
+    RAISE EXCEPTION '[EG1.1] _economy_guard_access_context drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public._economy_guard_assert_access()')))
+    INTO v_hash;
+  IF v_hash <> 'c10dc0b5f8fa17330f411598707b84d0' THEN
+    RAISE EXCEPTION '[EG1.1] _economy_guard_assert_access drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public._economy_guard_inequality(integer)')))
+    INTO v_hash;
+  IF v_hash <> '2bf3d4cc186019d49f037800b4575c01' THEN
+    RAISE EXCEPTION '[EG1.1] _economy_guard_inequality drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public._economy_guard_transaction_rows(integer,date,date)')))
+    INTO v_hash;
+  IF v_hash <> 'ebaf109fc8afd5aacc67cf5b3a202ee3' THEN
+    RAISE EXCEPTION '[EG1.1] legacy transaction projection drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public._economy_guard_period_bounds(text,date,date)')))
+    INTO v_hash;
+  IF v_hash <> 'a6ad7eea73dd3c2f6d78df8f44be4297' THEN
+    RAISE EXCEPTION '[EG1.1] period helper drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public.is_official_participant(integer)')))
+    INTO v_hash;
+  IF v_hash <> '194c2d8769eb04bded9c0d61775d5cda' THEN
+    RAISE EXCEPTION '[EG1.1] official participant helper drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  SELECT md5(pg_get_functiondef(to_regprocedure('public.teacher_appoint_guard(integer,integer,public.guard_role_type,date,date,text)')))
+    INTO v_hash;
+  IF v_hash <> '17614e2090a678f6ad97f660f3532545' THEN
+    RAISE EXCEPTION '[EG1.1] teacher_appoint_guard drifted: %',v_hash USING ERRCODE='P8102';
+  END IF;
+
+  -- New EG1.1 objects must be unused/free for this one-time migration.
+  IF to_regclass('public.economy_guard_event_reviews') IS NOT NULL
+     OR to_regclass('public.economy_guard_event_penalties') IS NOT NULL
+     OR to_regprocedure('public._economy_guard_p2p_event_rows(integer,date,date)') IS NOT NULL
+     OR to_regprocedure('public._economy_guard_service_event_rows(integer,date,date)') IS NOT NULL
+     OR to_regprocedure('public._economy_guard_event_rows(integer,date,date)') IS NOT NULL
+     OR to_regprocedure('public.economy_guard_get_dashboard_v2(text,date,date)') IS NOT NULL
+     OR to_regprocedure('public.economy_guard_get_ai_context_v2(text,date,date)') IS NOT NULL
+     OR to_regprocedure('public.economy_guard_mark_event_normal(text,bigint,text)') IS NOT NULL
+     OR to_regprocedure('public.economy_guard_flag_event(text,bigint,integer,text,text)') IS NOT NULL THEN
+    RAISE EXCEPTION '[EG1.1] one-time migration objects already exist; do not rerun' USING ERRCODE='P8103';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+    FROM pg_trigger t
+    JOIN pg_class c ON c.oid=t.tgrelid
+    JOIN pg_namespace n ON n.oid=c.relnamespace
+    WHERE n.nspname='public'
+      AND c.relname='guard_terms'
+      AND t.tgname='trg_guard_terms_official_participant'
+      AND NOT t.tgisinternal
+  ) THEN
+    RAISE EXCEPTION '[EG1.1] guard official-participant trigger already exists' USING ERRCODE='P8103';
+  END IF;
+
+  -- Because new generic audit tables start fresh, refuse silent loss of old decisions.
+  IF EXISTS (SELECT 1 FROM public.economy_guard_transfer_reviews LIMIT 1)
+     OR EXISTS (SELECT 1 FROM public.economy_guard_penalties LIMIT 1) THEN
+    RAISE EXCEPTION '[EG1.1] legacy review/penalty data exists; explicit migration is required first' USING ERRCODE='P8104';
+  END IF;
+
+  -- Current service contract required by the adapter.
+  IF NOT EXISTS (
+      SELECT 1 FROM information_schema.columns
+      WHERE table_schema='public' AND table_name='secondary_job_service_orders'
+        AND column_name='buyer_student_id'
+    )
+    OR NOT EXISTS (
+      SELECT 1 FROM information_schema.columns
+      WHERE table_schema='public' AND table_name='secondary_job_service_orders'
+        AND column_name='seller_student_id'
+    )
+    OR NOT EXISTS (
+      SELECT 1 FROM information_schema.columns
+      WHERE table_schema='public' AND table_name='secondary_job_service_orders'
+        AND column_name='price_gold_snapshot'
+    )
+    OR NOT EXISTS (
+      SELECT 1 FROM information_schema.columns
+      WHERE table_schema='public' AND table_name='secondary_job_service_orders'
+        AND column_name='buyer_request'
+    )
+    OR NOT EXISTS (
+      SELECT 1 FROM information_schema.columns
+      WHERE table_schema='public' AND table_name='secondary_job_service_orders'
+        AND column_name='status'
+    ) THEN
+    RAISE EXCEPTION '[EG1.1] service-order schema drifted' USING ERRCODE='P8105';
+  END IF;
+END
+$eg11_precondition$;
