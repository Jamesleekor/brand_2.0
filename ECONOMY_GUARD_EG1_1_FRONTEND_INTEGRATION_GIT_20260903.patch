+      {event.penalty && (
+        <div className="mt-2 rounded-card-sm border border-danger/25 bg-danger-bg px-3 py-2 text-xs font-bold text-text-secondary">
+          <span className="font-black text-danger">{event.penalty.reason}</span> · {event.penalty.subject_brand_name || event.penalty.subject_name || `학생 #${event.penalty.subject_student_id}`}
+          {event.penalty.memo ? ` · ${event.penalty.memo}` : ''}
