+
+-- ============================================================================
+-- 7. GENERIC APPEND-ONLY REVIEW WRITE RPCs
+-- ============================================================================
+
+CREATE FUNCTION public.economy_guard_mark_event_normal(
+  p_source_kind text,
+  p_source_id bigint,
+  p_memo text DEFAULT NULL::text
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path TO 'public','pg_temp'
+AS $eg11_mark_normal$
+DECLARE
+  v_access jsonb:=public._economy_guard_assert_access();
+  v_class integer:=(v_access->>'classroom_id')::integer;
+  v_student integer:=nullif(v_access->>'student_id','')::integer;
+  v_term integer:=nullif(v_access->>'active_term_id','')::integer;
+  v_kind text:=upper(btrim(coalesce(p_source_kind,'')));
+  v_event record;
+  v_review_id bigint;
+  v_snapshot jsonb;
+BEGIN
+  IF v_kind NOT IN ('P2P_TRANSFER','SERVICE_ORDER') THEN
+    RAISE EXCEPTION '[EG1.1] invalid source kind' USING ERRCODE='PK112';
+  END IF;
+
+  IF p_source_id IS NULL OR p_source_id<=0 THEN
+    RAISE EXCEPTION '[EG1.1] invalid source id' USING ERRCODE='PK113';
+  END IF;
+
+  IF char_length(coalesce(p_memo,''))>500 THEN
+    RAISE EXCEPTION '[EG1.1] memo too long' USING ERRCODE='PK103';
+  END IF;
+
+  SELECT *
+    INTO v_event
+  FROM public._economy_guard_event_rows(v_class,NULL,NULL) e
+  WHERE e.source_kind=v_kind
+    AND e.source_id=p_source_id
+  LIMIT 1;
+
+  IF v_event.source_id IS NULL THEN
+    RAISE EXCEPTION '[EG1.1] event not found or not an official classroom event'
+      USING ERRCODE='PK104';
+  END IF;
+
+  IF NOT coalesce(v_event.is_suspicious,false)
+     OR NOT coalesce(v_event.is_actionable,false) THEN
+    RAISE EXCEPTION '[EG1.1] event has no actionable anomaly signal'
+      USING ERRCODE='PK109';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+    FROM public.economy_guard_event_penalties p
+    WHERE p.classroom_id=v_class
+      AND p.source_kind=v_kind
+      AND p.source_id=p_source_id
+  ) THEN
+    RAISE EXCEPTION '[EG1.1] final-flagged event cannot be marked normal'
+      USING ERRCODE='PK107';
+  END IF;
+
+  v_snapshot:=jsonb_build_object(
+    'source_kind',v_event.source_kind,
+    'source_id',v_event.source_id,
+    'event_key',v_event.event_key,
+    'occurred_at',v_event.occurred_at,
+    'trade_date',v_event.trade_date,
+    'sender_id',v_event.sender_id,
+    'receiver_id',v_event.receiver_id,
+    'amount',v_event.amount,
+    'quantity',v_event.quantity,
+    'unit_price',v_event.unit_price,
+    'tag',v_event.tag,
+    'description',v_event.description,
+    'raw_status',v_event.raw_status,
+    'economic_state',v_event.economic_state,
+    'anomaly_reasons',to_jsonb(v_event.anomaly_reasons),
+    'source_meta',v_event.source_meta
+  );
+
+  INSERT INTO public.economy_guard_event_reviews(
+    classroom_id,source_kind,source_id,decision,basis_hash,event_snapshot,memo,
+    reviewed_by_student_id,reviewed_by_user_id,guard_term_id,reviewed_at
+  )
+  VALUES(
+    v_class,v_kind,p_source_id,'NORMAL_CONFIRMED',
+    v_event.anomaly_fingerprint,v_snapshot,
+    nullif(btrim(coalesce(p_memo,'')),''),
+    v_student,auth.uid(),v_term,now()
+  )
+  ON CONFLICT (classroom_id,source_kind,source_id,decision,basis_hash)
+  DO NOTHING
+  RETURNING id INTO v_review_id;
+
+  IF v_review_id IS NULL THEN
+    SELECT r.id
+      INTO v_review_id
+    FROM public.economy_guard_event_reviews r
+    WHERE r.classroom_id=v_class
+      AND r.source_kind=v_kind
+      AND r.source_id=p_source_id
+      AND r.decision='NORMAL_CONFIRMED'
+      AND r.basis_hash=v_event.anomaly_fingerprint
+    ORDER BY r.id DESC
+    LIMIT 1;
+  END IF;
+
+  RETURN jsonb_build_object(
+    'success',true,
+    'source_kind',v_kind,
+    'source_id',p_source_id,
+    'event_key',v_event.event_key,
+    'review_status','NORMAL_CONFIRMED',
+    'review_id',v_review_id,
+    'basis_hash',v_event.anomaly_fingerprint
+  );
+END
+$eg11_mark_normal$;
+
+
+CREATE FUNCTION public.economy_guard_flag_event(
+  p_source_kind text,
+  p_source_id bigint,
+  p_subject_student_id integer,
+  p_reason text,
+  p_memo text DEFAULT NULL::text
+)
+RETURNS jsonb
+LANGUAGE plpgsql
+SECURITY DEFINER
+SET search_path TO 'public','pg_temp'
+AS $eg11_flag$
+DECLARE
+  v_access jsonb:=public._economy_guard_assert_access();
+  v_class integer:=(v_access->>'classroom_id')::integer;
+  v_student integer:=nullif(v_access->>'student_id','')::integer;
+  v_term integer:=nullif(v_access->>'active_term_id','')::integer;
+  v_kind text:=upper(btrim(coalesce(p_source_kind,'')));
+  v_reason text:=btrim(coalesce(p_reason,''));
+  v_event record;
+  v_penalty_id bigint;
+  v_penalty_uid text;
+  v_review_id bigint;
+  v_subject_name text;
+  v_snapshot jsonb;
+BEGIN
+  IF v_kind NOT IN ('P2P_TRANSFER','SERVICE_ORDER') THEN
+    RAISE EXCEPTION '[EG1.1] invalid source kind' USING ERRCODE='PK112';
+  END IF;
+
+  IF p_source_id IS NULL OR p_source_id<=0 THEN
+    RAISE EXCEPTION '[EG1.1] invalid source id' USING ERRCODE='PK113';
+  END IF;
+
+  IF v_reason NOT IN ('사유 허위 기재','실물 거래 의심','강압적 거래','소명 거부','기타') THEN
+    RAISE EXCEPTION '[EG1.1] invalid penalty reason' USING ERRCODE='PK105';
+  END IF;
+
+  IF char_length(coalesce(p_memo,''))>500
+     OR (v_reason='기타' AND char_length(btrim(coalesce(p_memo,'')))<2) THEN
+    RAISE EXCEPTION '[EG1.1] penalty memo invalid' USING ERRCODE='PK103';
+  END IF;
+
+  SELECT *
+    INTO v_event
+  FROM public._economy_guard_event_rows(v_class,NULL,NULL) e
+  WHERE e.source_kind=v_kind
+    AND e.source_id=p_source_id
+  LIMIT 1;
+
+  IF v_event.source_id IS NULL THEN
+    RAISE EXCEPTION '[EG1.1] event not found or not an official classroom event'
+      USING ERRCODE='PK104';
+  END IF;
+
+  IF NOT coalesce(v_event.is_suspicious,false)
+     OR NOT coalesce(v_event.is_actionable,false) THEN
+    RAISE EXCEPTION '[EG1.1] event has no actionable anomaly signal'
+      USING ERRCODE='PK109';
+  END IF;
+
+  IF p_subject_student_id NOT IN (v_event.sender_id,v_event.receiver_id) THEN
+    RAISE EXCEPTION '[EG1.1] penalty subject must be an event participant'
+      USING ERRCODE='PK106';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+    FROM public.economy_guard_event_penalties p
+    WHERE p.classroom_id=v_class
+      AND p.source_kind=v_kind
+      AND p.source_id=p_source_id
+  ) THEN
+    RAISE EXCEPTION '[EG1.1] event already final-flagged' USING ERRCODE='PK108';
+  END IF;
+
+  -- A current, same-basis NORMAL decision closes that exact alert.
+  -- A changed/stale basis may be escalated.
+  IF EXISTS (
+    SELECT 1
+    FROM public.economy_guard_event_reviews r
+    WHERE r.classroom_id=v_class
+      AND r.source_kind=v_kind
+      AND r.source_id=p_source_id
+      AND r.decision='NORMAL_CONFIRMED'
+      AND r.basis_hash=v_event.anomaly_fingerprint
+  ) THEN
+    RAISE EXCEPTION '[EG1.1] current anomaly basis is already confirmed normal'
+      USING ERRCODE='PK110';
+  END IF;
+
+  SELECT coalesce(nullif(s.brand_name,''),s.name)
+    INTO v_subject_name
+  FROM public.students s
+  WHERE s.id=p_subject_student_id;
+
+  v_snapshot:=jsonb_build_object(
+    'source_kind',v_event.source_kind,
+    'source_id',v_event.source_id,
+    'event_key',v_event.event_key,
+    'occurred_at',v_event.occurred_at,
+    'trade_date',v_event.trade_date,
+    'sender_id',v_event.sender_id,
+    'receiver_id',v_event.receiver_id,
+    'amount',v_event.amount,
+    'quantity',v_event.quantity,
+    'unit_price',v_event.unit_price,
+    'tag',v_event.tag,
+    'description',v_event.description,
+    'raw_status',v_event.raw_status,
+    'economic_state',v_event.economic_state,
+    'anomaly_reasons',to_jsonb(v_event.anomaly_reasons),
+    'source_meta',v_event.source_meta
+  );
+
+  v_penalty_uid:=
+    'EGP2_'||
+    extract(epoch FROM clock_timestamp())::bigint::text||
+    '_'||
+    substring(md5(random()::text||clock_timestamp()::text),1,8);
+
+  INSERT INTO public.economy_guard_event_penalties(
+    penalty_uid,classroom_id,source_kind,source_id,subject_student_id,
+    reason,memo,basis_hash,event_snapshot,
+    flagged_by_student_id,flagged_by_user_id,guard_term_id
+  )
+  VALUES(
+    v_penalty_uid,v_class,v_kind,p_source_id,p_subject_student_id,
+    v_reason,nullif(btrim(coalesce(p_memo,'')),''),
+    v_event.anomaly_fingerprint,v_snapshot,
+    v_student,auth.uid(),v_term
+  )
+  RETURNING id INTO v_penalty_id;
+
+  INSERT INTO public.economy_guard_event_reviews(
+    classroom_id,source_kind,source_id,decision,basis_hash,event_snapshot,memo,
+    reviewed_by_student_id,reviewed_by_user_id,guard_term_id,reviewed_at
+  )
+  VALUES(
+    v_class,v_kind,p_source_id,'FINAL_FLAGGED',
+    v_event.anomaly_fingerprint,v_snapshot,
+    nullif(btrim(coalesce(p_memo,'')),''),
+    v_student,auth.uid(),v_term,now()
+  )
+  RETURNING id INTO v_review_id;
+
+  PERFORM public.send_mail(
+    p_subject_student_id,
+    'TEACHER'::public.mail_sender_type,
+    NULL::integer,
+    NULL::uuid,
+    '🚨 경제수호대 적발 통보'::varchar,
+    format(
+      '경제수호대에 의해 경제 이벤트(%s)가 최종 적발되었습니다.%s사유: %s%s이의가 있을 경우 선생님께 문의하세요.',
+      v_event.event_key,E'\n',v_reason,E'\n'
+    ),
+    'P2P_NOTE'::public.mail_message_type,
+    NULL::public.transaction_source_type,
+    p_source_id
+  );
+
+  RETURN jsonb_build_object(
+    'success',true,
+    'source_kind',v_kind,
+    'source_id',p_source_id,
+    'event_key',v_event.event_key,
+    'review_status','FINAL_FLAGGED',
+    'review_id',v_review_id,
+    'penalty_id',v_penalty_id,
+    'subject_student_id',p_subject_student_id,
+    'subject_name',v_subject_name,
+    'basis_hash',v_event.anomaly_fingerprint
+  );
+END
+$eg11_flag$;
+
+
+-- ============================================================================
+-- 8. ACL FOR NEW EXTERNAL RPCs
+-- ============================================================================
+
+REVOKE ALL ON FUNCTION public.economy_guard_get_dashboard_v2(text,date,date)
+  FROM PUBLIC,anon;
+REVOKE ALL ON FUNCTION public.economy_guard_get_ai_context_v2(text,date,date)
+  FROM PUBLIC,anon;
+REVOKE ALL ON FUNCTION public.economy_guard_mark_event_normal(text,bigint,text)
+  FROM PUBLIC,anon;
+REVOKE ALL ON FUNCTION public.economy_guard_flag_event(text,bigint,integer,text,text)
+  FROM PUBLIC,anon;
+
+GRANT EXECUTE ON FUNCTION public.economy_guard_get_dashboard_v2(text,date,date)
+  TO authenticated,service_role;
+GRANT EXECUTE ON FUNCTION public.economy_guard_get_ai_context_v2(text,date,date)
+  TO authenticated,service_role;
+GRANT EXECUTE ON FUNCTION public.economy_guard_mark_event_normal(text,bigint,text)
+  TO authenticated,service_role;
+GRANT EXECUTE ON FUNCTION public.economy_guard_flag_event(text,bigint,integer,text,text)
+  TO authenticated,service_role;
+
+
+-- ============================================================================
+-- 9. APPLY-TIME INVARIANT CHECKS
+-- ============================================================================
+
+DO $eg11_post_apply$
+DECLARE
+  v_bad integer;
+BEGIN
+  IF to_regclass('public.economy_guard_event_reviews') IS NULL
+     OR to_regclass('public.economy_guard_event_penalties') IS NULL
+     OR to_regprocedure('public._economy_guard_event_rows(integer,date,date)') IS NULL
+     OR to_regprocedure('public.economy_guard_get_dashboard_v2(text,date,date)') IS NULL
+     OR to_regprocedure('public.economy_guard_mark_event_normal(text,bigint,text)') IS NULL
+     OR to_regprocedure('public.economy_guard_flag_event(text,bigint,integer,text,text)') IS NULL THEN
+    RAISE EXCEPTION '[EG1.1] post-apply object check failed' USING ERRCODE='P8190';
+  END IF;
+
+  SELECT count(*)
+    INTO v_bad
+  FROM public.classrooms c
+  CROSS JOIN LATERAL public._economy_guard_event_rows(c.id,NULL,NULL) e
+  WHERE NOT public.is_official_participant(e.sender_id)
+     OR NOT public.is_official_participant(e.receiver_id);
+
+  IF v_bad<>0 THEN
+    RAISE EXCEPTION '[EG1.1] canonical event projection leaked non-official participant(s): %',v_bad
+      USING ERRCODE='P8191';
+  END IF;
+
+  IF EXISTS (
+    SELECT 1
+    FROM public.economy_guard_event_reviews
+    UNION ALL
+    SELECT 1
+    FROM public.economy_guard_event_penalties
+  ) THEN
+    RAISE EXCEPTION '[EG1.1] new audit tables unexpectedly contain rows during migration'
+      USING ERRCODE='P8192';
+  END IF;
+END
+$eg11_post_apply$;
+
+COMMIT;
