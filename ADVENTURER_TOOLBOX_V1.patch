+  spotlight_card?: { card_id: number; title: string; body: string; author?: string } | null;
+  submitted?: number;
+  eligible?: number;
+}
+
+export interface StudentFeedItem {
+  id: number;
+  kind: ClassActivityKind;
+  title: string;
