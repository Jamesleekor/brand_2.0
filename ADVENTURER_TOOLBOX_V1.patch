+function seededOrder<T>(items: T[], seed: number): T[] {
+  const a = items.slice();
+  let x = seed * 9301 + 49297;
+  for (let i = a.length - 1; i > 0; i -= 1) { x = (x * 9301 + 49297) % 233280; const j = Math.floor((x / 233280) * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; }
+  return a;
+}
