+        </section>
+        <section className="tbx-panel tbx-stack">
+          {!match ? <p className="tbx-small">경기를 골라 주세요.</p> : (
+            <>
+              <h2 className="tbx-h2">{match === 'T' ? '3위 결정전' : roundName(Number(match.slice(1).split('-')[0]), rounds)} {match !== 'T' && `${match.split('-')[1]}경기`}</h2>
