@@ -0,0 +1,143 @@
+// 타이머·스톱워치
+
+import { useEffect, useState } from 'react';
+import { Seg, formatClock } from '../ui';
+import { StageShell, ToolHeader, useLocalState, useToolChrome, type PersonalToolProps } from './common';
+import {
+  swElapsed, swIdle, timerAdjust, timerIdle, timerPause, timerRemaining, timerReset, timerStart, useNow,
+  type StopwatchData, type TimerData,
+} from './timer_engine';
+
+const PRESETS = [1, 3, 5, 10, 15];
+
+export function TimerDial({ remaining, total, warnAt = 60_000, size = 'normal' }: { remaining: number; total: number; warnAt?: number; size?: 'normal' | 'compact' }) {
+  const ratio = total > 0 ? Math.min(1, Math.max(0, remaining / total)) : 0;
+  const r = 46;
+  const c = 2 * Math.PI * r;
+  const done = remaining <= 0;
+  const warn = !done && remaining <= warnAt;
+  return (
+    <div className="tbx-dial" data-warn={warn} data-done={done} style={size === 'compact' ? { width: 'min(56vw, 220px)' } : undefined}
+      role="timer" aria-label={`남은 시간 ${formatClock(remaining)}`}>
+      <svg viewBox="0 0 100 100" aria-hidden="true">
+        <circle cx="50" cy="50" r={r} fill="none" stroke="rgba(244,236,221,.08)" strokeWidth="6" />
+        <circle cx="50" cy="50" r={r} fill="none" stroke={done ? '#ff7b6b' : warn ? '#f3d59a' : '#e4bc72'} strokeWidth="6" strokeLinecap="round"
+          strokeDasharray={c} strokeDashoffset={c * (1 - ratio)} style={{ transition: 'stroke-dashoffset .25s linear, stroke .3s ease' }} />
+        {Array.from({ length: 60 }).map((_, i) => (
+          <line key={i} x1="50" y1="2.5" x2="50" y2={i % 5 === 0 ? 6 : 4.2} stroke="rgba(244,236,221,.28)" strokeWidth={i % 5 === 0 ? 0.9 : 0.5} transform={`rotate(${i * 6} 50 50)`} />
+        ))}
+      </svg>
+      <div className="tbx-dial__text">
+        <div className="tbx-dial__time" style={size === 'compact' ? { fontSize: 40 } : undefined}>{formatClock(remaining)}</div>
+        {done && <div className="tbx-h3 tbx-ember-text" style={{ marginTop: 8 }}>시간이 다 됐어요</div>}
+      </div>
+    </div>
+  );
+}
+
+export function TimerTool(props: PersonalToolProps) {
+  const { prefs, fs, chrome } = useToolChrome();
+  const [mode, setMode] = useLocalState<'timer' | 'stopwatch'>(`brand.toolbox.${props.ownerKey}.timer.mode`, 'timer');
+  const [timer, setTimer] = useLocalState<TimerData>(`brand.toolbox.${props.ownerKey}.timer.t`, timerIdle(5 * 60_000));
+  const [sw, setSw] = useLocalState<StopwatchData>(`brand.toolbox.${props.ownerKey}.timer.sw`, swIdle);
+  const running = mode === 'timer' ? timer.endsAt !== null : sw.startedAt !== null;
+  const now = useNow(running, mode === 'stopwatch' ? 60 : 200);
+  const remaining = timerRemaining(timer, now);
+  const [h, setH] = useState(Math.floor(timer.durationMs / 3_600_000));
+  const [m, setM] = useState(Math.floor((timer.durationMs % 3_600_000) / 60_000));
+  const [s, setS] = useState(Math.floor((timer.durationMs % 60_000) / 1000));
+
+  // 끝났을 때 알림은 한 번만
+  useEffect(() => {
+    if (timer.endsAt !== null && remaining <= 0 && !timer.alarmed) {
+      setTimer((t) => ({ ...t, endsAt: null, pausedRemaining: 0, alarmed: true }));
+      prefs.play('alarm');
+    }
+  }, [remaining, timer.endsAt, timer.alarmed]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  const applyDuration = (ms: number) => {
+    const clamped = Math.min(Math.max(ms, 1000), 24 * 3_600_000 - 1000);
+    setTimer(timerIdle(clamped));
+    setH(Math.floor(clamped / 3_600_000)); setM(Math.floor((clamped % 3_600_000) / 60_000)); setS(Math.floor((clamped % 60_000) / 1000));
+  };
+  const idle = timer.endsAt === null && timer.pausedRemaining === null;
+  const elapsed = swElapsed(sw, now);
+
+  return (
+    <div className="tbx tbx-page" data-reduce-motion={prefs.reduceMotion}>
+      <ToolHeader tool="timer" right={chrome} />
+      <Seg value={mode} onChange={setMode} options={[{ value: 'timer', label: '타이머' }, { value: 'stopwatch', label: '스톱워치' }]} label="모드" />
+      <div className="tbx-split">
+        <StageShell fs={fs} prefs={prefs} tall corner={fs.on ? <button className="tbx-btn tbx-btn--sm" onClick={() => void fs.toggle()}>전체 화면 끝내기</button> : undefined}>
+          {mode === 'timer' ? (
+            <div className="tbx-stack" style={{ alignItems: 'center', gap: 22 }}>
+              <TimerDial remaining={remaining} total={timer.durationMs} />
+              <div className="tbx-row tbx-row--wrap" style={{ justifyContent: 'center' }}>
+                {timer.endsAt !== null
+                  ? <button type="button" className="tbx-btn tbx-btn--xl" onClick={() => setTimer((t) => timerPause(t, Date.now()))}>일시 정지</button>
+                  : <button type="button" className="tbx-btn tbx-btn--brass tbx-btn--xl" disabled={remaining <= 0} onClick={() => setTimer((t) => timerStart(t, Date.now()))}>{idle ? '시작' : '다시 시작'}</button>}
+                <button type="button" className="tbx-btn tbx-btn--lg" disabled={idle} onClick={() => setTimer((t) => timerReset(t))}>처음으로</button>
+              </div>
+              <div className="tbx-row tbx-row--wrap" style={{ justifyContent: 'center' }}>
+                <button type="button" className="tbx-btn tbx-btn--sm" onClick={() => setTimer((t) => timerAdjust(t, -60_000, Date.now()))} disabled={remaining <= 0}>−1분</button>
+                <button type="button" className="tbx-btn tbx-btn--sm" onClick={() => setTimer((t) => timerAdjust(t, -10_000, Date.now()))} disabled={remaining <= 0}>−10초</button>
+                <button type="button" className="tbx-btn tbx-btn--sm" onClick={() => setTimer((t) => timerAdjust(t, 10_000, Date.now()))}>+10초</button>
+                <button type="button" className="tbx-btn tbx-btn--sm" onClick={() => setTimer((t) => timerAdjust(t, 60_000, Date.now()))}>+1분</button>
+              </div>
+            </div>
+          ) : (
+            <div className="tbx-stack" style={{ alignItems: 'center', gap: 22 }}>
+              <div className="tbx-num" style={{ fontSize: 'clamp(52px, 13vw, 96px)', lineHeight: 1 }} role="timer">{formatClock(elapsed, true)}</div>
+              <div className="tbx-row tbx-row--wrap" style={{ justifyContent: 'center' }}>
+                {sw.startedAt !== null
+                  ? <button type="button" className="tbx-btn tbx-btn--xl" onClick={() => setSw((x) => ({ ...x, startedAt: null, accumulated: swElapsed(x, Date.now()) }))}>일시 정지</button>
+                  : <button type="button" className="tbx-btn tbx-btn--brass tbx-btn--xl" onClick={() => setSw((x) => ({ ...x, startedAt: Date.now() }))}>{elapsed > 0 ? '이어서' : '시작'}</button>}
+                <button type="button" className="tbx-btn tbx-btn--lg" disabled={sw.startedAt === null} onClick={() => setSw((x) => ({ ...x, laps: [swElapsed(x, Date.now()), ...x.laps].slice(0, 99) }))}>구간 기록</button>
+                <button type="button" className="tbx-btn tbx-btn--lg tbx-btn--ghost" disabled={elapsed === 0} onClick={() => setSw(swIdle)}>초기화</button>
+              </div>
+              {sw.laps.length > 0 && (
+                <ol className="tbx-list" style={{ width: 'min(100%, 360px)', maxHeight: 240, overflow: 'auto' }}>
+                  {sw.laps.map((t, i) => {
+                    const prev = sw.laps[i + 1] ?? 0;
+                    return (
+                      <li key={sw.laps.length - i} className="tbx-list__row">
+                        <span className="tbx-rank">{sw.laps.length - i}</span>
+                        <span className="tbx-grow tbx-num" style={{ fontSize: 18 }}>{formatClock(t, true)}</span>
+                        <span className="tbx-small">구간 +{formatClock(t - prev, true)}</span>
+                      </li>
+                    );
+                  })}
+                </ol>
+              )}
+            </div>
+          )}
+        </StageShell>
+
+        {mode === 'timer' && (
+          <section className="tbx-panel tbx-stack">
+            <h2 className="tbx-h2">시간 정하기</h2>
+            <div className="tbx-row tbx-row--wrap">
+              {PRESETS.map((min) => (
+                <button key={min} type="button" className="tbx-btn tbx-btn--sm" disabled={!idle} aria-pressed={timer.durationMs === min * 60_000}
+                  onClick={() => applyDuration(min * 60_000)}>{min}분</button>
+              ))}
+            </div>
+            <div className="tbx-row" style={{ gap: 6 }}>
+              {[['시간', h, setH, 23], ['분', m, setM, 59], ['초', s, setS, 59]].map(([label, v, set, max]: any) => (
+                <label key={label} style={{ flex: 1 }}>
+                  <span className="tbx-label">{label}</span>
+                  <input className="tbx-input tbx-input--num" inputMode="numeric" disabled={!idle} value={v}
+                    onChange={(e) => set(Math.min(max, Math.max(0, Number(e.target.value.replace(/\D/g, '') || 0))))} />
+                </label>
+              ))}
+            </div>
+            <button type="button" className="tbx-btn tbx-btn--block" disabled={!idle || h * 3600 + m * 60 + s === 0}
+              onClick={() => applyDuration((h * 3600 + m * 60 + s) * 1000)}>이 시간으로 맞추기</button>
+            {!idle && <p className="tbx-hint">시간을 새로 정하려면 ‘처음으로’를 눌러 주세요. 실행 중에는 아래 ±버튼으로 바꿀 수 있어요.</p>}
+            <p className="tbx-hint">다른 화면에 갔다 와도 시간은 계속 흘러요. 일시 정지한 동안만 멈춰요.</p>
+          </section>
+        )}
+      </div>
+    </div>
+  );
+}
diff --git a/src/features/toolbox/personal/common.tsx b/src/features/toolbox/personal/common.tsx
new file mode 100644
index 0000000..a33a7d9
--- /dev/null
+++ b/src/features/toolbox/personal/common.tsx
@@ -0,0 +1,141 @@
+// =====================================================================
+// 개인 도구 공통 — 머리말, 기기 안 임시 보관, 준비 패널
+// ---------------------------------------------------------------------
+// 개인 도구는 서버에 저장하지 않는다. 같은 기기에서 새로고침했을 때
+// 이어 볼 수 있도록 이 기기 안(localStorage)에만 잠시 보관한다.
+// 보관이 안 되는 환경에서도 도구는 정상 작동한다.
+// =====================================================================
+
+import { useCallback, useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { ParticipantPicker, PickerSummary, type PickerOptions } from '../ParticipantPicker';
+import { buildUnits, useClassRoster, type ClassRoster } from '../roster';
+import { toolboxRpc } from '../toolbox_rpc';
+import { Glyph, PrefButtons, useFullscreen, useToolboxPrefs, type GlyphName } from '../ui';
+import type { PersonalToolId, RosterItem, Unit } from '../toolbox_types';
+
+export interface PersonalToolProps {
+  client: SupabaseClient;
+  classroomId: number | null;
+  audience: 'student' | 'teacher';
+  /** 기기 안 보관 키를 사람마다 나누기 위한 값 */
+  ownerKey: string;
+  /** 교사 팀 만들기 → 학급 활동으로 보내기 */
+  onSendTeams?: (target: 'SCOREBOARD' | 'TOURNAMENT' | 'BUZZER', teams: RosterItem[]) => void;
+  /** 순서 정하기 등에서 다른 개인 도구로 이동 */
+  onOpenTool?: (tool: PersonalToolId) => void;
+}
+
+export const PERSONAL_TOOLS: { id: PersonalToolId; name: string; desc: string; glyph: GlyphName }[] = [
+  { id: 'lottery', name: '제비뽑기', desc: '가려진 제비를 골라 결과를 확인해요', glyph: 'lottery' },
+  { id: 'ladder', name: '사다리타기', desc: '사람과 결과를 사다리로 한 명씩 이어요', glyph: 'ladder' },
+  { id: 'roulette', name: '룰렛', desc: '모두 같은 확률로 한 명을 골라요', glyph: 'roulette' },
+  { id: 'order', name: '순서 정하기', desc: '모두의 발표 순서를 한 번에 정해요', glyph: 'order' },
+  { id: 'timer', name: '타이머·스톱워치', desc: '남은 시간과 걸린 시간을 크게 보여줘요', glyph: 'timer' },
+  { id: 'teams', name: '팀 만들기', desc: '정한 인원으로 팀을 고르게 나눠요', glyph: 'teams' },
+];
+
+// ---------------------------------------------------------------------
+// 기기 안 임시 보관
+// ---------------------------------------------------------------------
+export function useLocalState<T>(key: string, initial: T): [T, (next: T | ((prev: T) => T)) => void, () => void] {
+  const read = (): T => {
+    try {
+      const raw = window.localStorage.getItem(key);
+      return raw ? (JSON.parse(raw) as T) : initial;
+    } catch { return initial; }
+  };
+  const [state, setState] = useState<T>(read);
+  const keyRef = useRef(key);
+  useEffect(() => { if (keyRef.current !== key) { keyRef.current = key; setState(read()); } }, [key]); // eslint-disable-line react-hooks/exhaustive-deps
+  const set = useCallback((next: T | ((prev: T) => T)) => {
+    setState((prev) => {
+      const value = typeof next === 'function' ? (next as (p: T) => T)(prev) : next;
+      try { window.localStorage.setItem(key, JSON.stringify(value)); } catch { /* 보관 실패는 무시 */ }
+      return value;
+    });
+  }, [key]);
+  const clear = useCallback(() => {
+    try { window.localStorage.removeItem(key); } catch { /* 무시 */ }
+    setState(initial);
+  }, [key]); // eslint-disable-line react-hooks/exhaustive-deps
+  return [state, set, clear];
+}
+
+// ---------------------------------------------------------------------
+// 화면 머리말
+// ---------------------------------------------------------------------
+export function ToolHeader({ tool, right }: { tool: PersonalToolId; right?: ReactNode }) {
+  const meta = PERSONAL_TOOLS.find((t) => t.id === tool)!;
+  return (
+    <div className="tbx-row tbx-row--between tbx-row--wrap" style={{ gap: 12 }}>
+      <div className="tbx-hero">
+        <Glyph name={meta.glyph} size="lg" />
+        <div>
+          <h1 className="tbx-h1">{meta.name}</h1>
+          <p className="tbx-small">{meta.desc}</p>
+        </div>
+      </div>
+      {right && <div className="tbx-row tbx-row--wrap" style={{ gap: 6 }}>{right}</div>}
+    </div>
+  );
+}
+
+// ---------------------------------------------------------------------
+// 참가자 준비 — 펼침/접힘
+// ---------------------------------------------------------------------
+export function useParticipants(props: PersonalToolProps, tool: PersonalToolId) {
+  const { roster } = useClassRoster(props.client, props.classroomId, props.audience === 'teacher');
+  const [items, setItems] = useLocalState<RosterItem[]>(`brand.toolbox.${props.ownerKey}.${tool}.items`, []);
+  const units = useMemo(() => buildUnits(items, roster), [items, roster]);
+  return { roster, items, setItems, units };
+}
+
+export function ParticipantSection({ props, roster, items, setItems, units, options, locked, onUnlock, title = '참가자' }: {
+  props: PersonalToolProps; roster: ClassRoster | null; items: RosterItem[]; setItems: (v: RosterItem[]) => void; units: Unit[];
+  options?: PickerOptions; locked?: boolean; onUnlock?: () => void; title?: string;
+}) {
+  return (
+    <section className="tbx-panel tbx-stack">
+      <h2 className="tbx-h2">{title}</h2>
+      {locked
+        ? <PickerSummary units={units} onEdit={() => onUnlock?.()} />
+        : <ParticipantPicker client={props.client} classroomId={props.classroomId} roster={roster} value={items} onChange={setItems}
+            options={{ teacher: props.audience === 'teacher', ...options }} />}
+    </section>
+  );
+}
+
+/** 교사가 개인 도구를 시작하면 최근 명단으로 남긴다(최근 5개만 유지). */
+export function rememberRecent(props: PersonalToolProps, name: string, items: RosterItem[]) {
+  if (props.audience !== 'teacher' || items.length === 0) return;
+  void toolboxRpc.saveRoster(props.client, name.slice(0, 40), items, true).catch(() => undefined);
+}
+
+export function useToolChrome() {
+  const prefs = useToolboxPrefs();
+  const fs = useFullscreen<HTMLDivElement>();
+  const chrome = (
+    <>
+      <PrefButtons prefs={prefs} />
+      <button type="button" className="tbx-btn tbx-btn--sm" onClick={() => void fs.toggle()}>{fs.on ? '전체 화면 끝내기' : '⛶ 전체 화면'}</button>
+    </>
+  );
+  return { prefs, fs, chrome };
+}
+
+/** 전체 화면에서도 같은 무대를 쓰도록 감싼다. */
+export function StageShell({ fs, prefs, children, tall, corner }: {
+  fs: ReturnType<typeof useFullscreen<HTMLDivElement>>; prefs: ReturnType<typeof useToolboxPrefs>;
+  children: ReactNode; tall?: boolean; corner?: ReactNode;
+}) {
+  return (
+    <div ref={fs.ref} className="tbx" data-reduce-motion={prefs.reduceMotion}
+      style={fs.on ? { background: 'var(--tbx-deep)', display: 'flex', flexDirection: 'column', justifyContent: 'center', padding: '3vh 3vw', overflow: 'auto' } : undefined}>
+      <div className={tall || fs.on ? 'tbx-stage tbx-stage--tall' : 'tbx-stage'} style={fs.on ? { minHeight: '86vh', border: 0 } : undefined}>
+        {corner && <div className="tbx-stage__corner">{corner}</div>}
+        {children}
+      </div>
+    </div>
+  );
+}
diff --git a/src/features/toolbox/personal/timer_engine.ts b/src/features/toolbox/personal/timer_engine.ts
new file mode 100644
index 0000000..3331246
--- /dev/null
+++ b/src/features/toolbox/personal/timer_engine.ts
@@ -0,0 +1,53 @@
+// 타이머·스톱워치 시간 계산
+// 시간은 '언제 끝나는지(종료 시각)'로 기억한다. 그래서 다른 탭으로 가거나
+// 새로고침해도 흐른 시간이 그대로 반영되고, 일시 정지한 시간만 멈춘다.
+
+import { useEffect, useRef, useState } from 'react';
+
+export interface TimerData {
+  durationMs: number;
+  /** 실행 중일 때 끝나는 시각(ms) */
+  endsAt: number | null;
+  /** 일시 정지 중일 때 남은 시간 */
+  pausedRemaining: number | null;
+  /** 이미 알림을 울렸는지 (돌아왔을 때 반복 알림 방지) */
+  alarmed: boolean;
+}
+
+export const timerIdle = (durationMs: number): TimerData => ({ durationMs, endsAt: null, pausedRemaining: null, alarmed: false });
+
+export function timerRemaining(t: TimerData, now: number): number {
+  if (t.endsAt !== null) return Math.max(0, t.endsAt - now);
+  if (t.pausedRemaining !== null) return t.pausedRemaining;
+  return t.durationMs;
+}
+
+export const timerStart = (t: TimerData, now: number): TimerData => ({
+  ...t, endsAt: now + (t.pausedRemaining ?? t.durationMs), pausedRemaining: null, alarmed: false,
+});
+export const timerPause = (t: TimerData, now: number): TimerData => ({ ...t, endsAt: null, pausedRemaining: timerRemaining(t, now) });
+export const timerReset = (t: TimerData): TimerData => timerIdle(t.durationMs);
+export function timerAdjust(t: TimerData, deltaMs: number, now: number): TimerData {
+  const remaining = Math.max(0, timerRemaining(t, now) + deltaMs);
+  if (t.endsAt !== null) return { ...t, endsAt: now + remaining, alarmed: remaining > 0 ? false : t.alarmed };
+  if (t.pausedRemaining !== null) return { ...t, pausedRemaining: remaining };
+  return { ...t, durationMs: Math.max(1000, remaining) };
+}
+
+export interface StopwatchData { startedAt: number | null; accumulated: number; laps: number[] }
+export const swIdle: StopwatchData = { startedAt: null, accumulated: 0, laps: [] };
+export const swElapsed = (s: StopwatchData, now: number) => s.accumulated + (s.startedAt !== null ? now - s.startedAt : 0);
+
+/** 화면이 보일 때만 자주 다시 그린다. */
+export function useNow(active: boolean, intervalMs = 200): number {
+  const [now, setNow] = useState(() => Date.now());
+  const raf = useRef<number | null>(null);
+  useEffect(() => {
+    if (!active) { setNow(Date.now()); return; }
+    const id = window.setInterval(() => { if (document.visibilityState === 'visible') setNow(Date.now()); }, intervalMs);
+    const onVis = () => setNow(Date.now());
+    document.addEventListener('visibilitychange', onVis);
+    return () => { window.clearInterval(id); document.removeEventListener('visibilitychange', onVis); if (raf.current) cancelAnimationFrame(raf.current); };
+  }, [active, intervalMs]);
+  return now;
+}
diff --git a/src/features/toolbox/roster.ts b/src/features/toolbox/roster.ts
new file mode 100644
index 0000000..f0b4f88
--- /dev/null
+++ b/src/features/toolbox/roster.ts
@@ -0,0 +1,177 @@
+// =====================================================================
+// 모험가 도구함 — 학급 명단 읽기 (읽기 전용)
+// ---------------------------------------------------------------------
+// 학생·길드·길드원·오늘 출석은 기존 표에서 읽기만 한다. 바꾸지 않는다.
+// 출석은 '출석·과제 운영(F4C · 4.1)'에 입력된 오늘 기록을 참조한다.
+// =====================================================================
+
+import { useEffect, useState } from 'react';
+import type { SupabaseClient } from '@supabase/supabase-js';
+import { getKstDateString } from '@/lib/utils/format';
+import { colorAt } from './ui';
+import type { RosterItem, Unit } from './toolbox_types';
+
+export interface RosterStudent {
+  id: number;
+  name: string;
+  brand_name: string | null;
+  is_test: boolean;
+}
+
+export interface RosterGuild {
+  id: number;
+  name: string;
+  logo_url: string | null;
+  member_ids: number[];
+}
+
+export type AttendanceMark = 'PRESENT' | 'LATE' | 'ABSENT' | 'EXCUSED';
+
+export interface ClassRoster {
+  students: RosterStudent[];
+  guilds: RosterGuild[];
+  /** 오늘 출석 기록. 교사 화면에서만 채워진다. */
+  attendance: Record<number, AttendanceMark> | null;
+  attendanceDate: string;
+}
+
+const cache = new Map<string, { at: number; value: ClassRoster }>();
+const STUDENT_ROLES = ['STUDENT', 'STUDENT_LEADER', 'GUARD', 'TEST'];
+
+export async function loadClassRoster(client: SupabaseClient, classroomId: number, withAttendance: boolean): Promise<ClassRoster> {
+  const key = `${classroomId}:${withAttendance ? 'a' : 'n'}`;
+  const hit = cache.get(key);
+  if (hit && Date.now() - hit.at < 60_000) return hit.value;
+  const today = getKstDateString();
+
+  const [s, g] = await Promise.all([
+    client.from('students').select('id,name,brand_name,role,is_test_account')
+      .eq('classroom_id', classroomId).is('transferred_at', null).order('name'),
+    client.from('guilds').select('id,name,logo_url,is_active').eq('classroom_id', classroomId).order('id'),
+  ]);
+  if (s.error) throw s.error;
+  if (g.error) throw g.error;
+  const guildRows = (g.data ?? []).filter((x: any) => x.is_active !== false);
+  const guildIds = guildRows.map((x: any) => x.id as number);
+
+  const [m, a] = await Promise.all([
+    guildIds.length
+      ? client.from('guild_members').select('guild_id,student_id').in('guild_id', guildIds).is('left_at', null)
+      : Promise.resolve({ data: [], error: null } as any),
+    withAttendance
+      ? client.from('attendances').select('student_id,status').eq('classroom_id', classroomId).eq('attendance_date', today)
+      : Promise.resolve({ data: null, error: null } as any),
+  ]);
+  if (m.error) throw m.error;
+  if (a.error) throw a.error;
+
+  const students: RosterStudent[] = (s.data ?? [])
+    .filter((x: any) => STUDENT_ROLES.includes(String(x.role)))
+    .map((x: any) => ({ id: x.id, name: x.name, brand_name: x.brand_name ?? null, is_test: x.is_test_account === true }));
+  const studentIds = new Set(students.map((x) => x.id));
+  const guilds: RosterGuild[] = guildRows.map((x: any) => ({
+    id: x.id, name: x.name, logo_url: x.logo_url ?? null,
+    member_ids: (m.data ?? []).filter((r: any) => r.guild_id === x.id && studentIds.has(r.student_id)).map((r: any) => r.student_id as number),
+  }));
+  let attendance: Record<number, AttendanceMark> | null = null;
+  if (withAttendance && a.data) {
+    attendance = {};
+    for (const row of a.data as any[]) attendance[row.student_id] = row.status as AttendanceMark;
+  }
+  const value = { students, guilds, attendance, attendanceDate: today };
+  cache.set(key, { at: Date.now(), value });
+  return value;
+}
+
+export function useClassRoster(client: SupabaseClient, classroomId: number | null | undefined, withAttendance: boolean) {
+  const [roster, setRoster] = useState<ClassRoster | null>(null);
+  const [error, setError] = useState<unknown>(null);
+  useEffect(() => {
+    if (!classroomId) return;
+    let alive = true;
+    loadClassRoster(client, classroomId, withAttendance)
+      .then((r) => { if (alive) { setRoster(r); setError(null); } })
+      .catch((e) => { if (alive) setError(e); });
+    return () => { alive = false; };
+  }, [client, classroomId, withAttendance]);
+  return { roster, error };
+}
+
+/** 같은 이름이 둘 이상인 학생은 브랜드명을 붙여 구분한다. */
+export function studentLabel(student: RosterStudent, all: RosterStudent[]): string {
+  const dup = all.filter((x) => x.name === student.name).length > 1;
+  if (!dup) return student.name;
+  return student.brand_name ? `${student.name}(${student.brand_name})` : `${student.name}#${student.id}`;
+}
+
+export function isAbsent(roster: ClassRoster | null, studentId: number): boolean {
+  return roster?.attendance?.[studentId] === 'ABSENT';
+}
+
+/**
+ * 선택 항목 → 실제 참가 단위.
+ * - 같은 학생은 경로가 달라도 한 번만 들어간다(학생 단위 기준).
+ * - 직접 입력 항목은 학생·길드와 합치지 않는다.
+ */
+export function buildUnits(items: RosterItem[], roster: ClassRoster | null): Unit[] {
+  const units: Unit[] = [];
+  const seenStudents = new Set<number>();
+  const seenKeys = new Set<string>();
+  const students = roster?.students ?? [];
+  const nameOf = (id: number) => {
+    const s = students.find((x) => x.id === id);
+    return s ? studentLabel(s, students) : `학생 ${id}`;
+  };
+  let colorIndex = 0;
+  const push = (u: Unit) => { if (!seenKeys.has(u.key)) { seenKeys.add(u.key); units.push(u); } };
+
+  for (const item of items) {
+    if (item.type === 'STUDENT') {
+      if (seenStudents.has(item.student_id)) continue;
+      seenStudents.add(item.student_id);
+      push({ key: `s${item.student_id}`, type: 'STUDENT', label: nameOf(item.student_id), student_id: item.student_id });
+    } else if (item.type === 'GUILD' && item.as === 'MEMBERS') {
+      for (const id of item.member_ids) {
+        if (seenStudents.has(id)) continue;
+        seenStudents.add(id);
+        push({ key: `s${id}`, type: 'STUDENT', label: nameOf(id), student_id: id });
+      }
+    } else if (item.type === 'GUILD') {
+      push({
+        key: `g${item.guild_id}`, type: 'GUILD', label: item.label, guild_id: item.guild_id,
+        color: item.color ?? colorAt(colorIndex++),
+        members: item.member_ids.map((id) => ({ student_id: id, label: nameOf(id) })),
+      });
+    } else if (item.type === 'TEAM') {
+      push({
+        key: `t${item.key}`, type: 'TEAM', label: item.label, color: item.color ?? colorAt(colorIndex++),
+        members: item.member_ids.map((id) => ({ student_id: id, label: nameOf(id) })),
+      });
+    } else {
+      push({ key: `m${item.id}`, type: 'MANUAL', label: item.label });
+    }
+  }
+  // 이름이 같은 직접 입력 항목은 구분 표시를 붙인다.
+  const counts = new Map<string, number>();
+  for (const u of units) counts.set(u.label, (counts.get(u.label) ?? 0) + 1);
+  const seq = new Map<string, number>();
+  for (const u of units) {
+    if (u.type === 'MANUAL' && (counts.get(u.label) ?? 0) > 1) {
+      const n = (seq.get(u.label) ?? 0) + 1;
+      seq.set(u.label, n);
+      u.label = `${u.label} ${String.fromCharCode(64 + Math.min(n, 26))}`;
+    }
+  }
+  return units;
+}
