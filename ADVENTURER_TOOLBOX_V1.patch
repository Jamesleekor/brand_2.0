+      if (!out[r][c - 1] && !out[r][c + 1]) out[r][c] = true;
+      else { const r2 = (r + 1) % rows; out[r2][c] = true; if (out[r2][c - 1]) out[r2][c - 1] = false; if (out[r2][c + 1]) out[r2][c + 1] = false; }
