+.tbx-stopwatch { font-size: clamp(64px, min(15vw, 24dvh), 240px); line-height: 1; }
+.tbx-tool[data-fullscreen="true"] .tbx-stopwatch { font-size: clamp(80px, min(16vw, 34vh), 360px); }
+.tbx-timer-layout { display: grid; gap: 22px; width: 100%; grid-template-columns: minmax(0, 1fr); justify-items: center; align-items: center; }
+@media (min-width: 900px) {
+  .tbx-timer-layout[data-laps="true"] { grid-template-columns: minmax(0, 1fr) 320px; }
+}
+.tbx-time-input { display: inline-flex; align-items: center; gap: 4px; }
+.tbx-time-input .tbx-input { width: 52px; padding: 8px 4px; }
+.tbx-time-input span { font-size: 12.5px; font-weight: 800; color: var(--tbx-ivory-2); }
+
+/* 팀 — 카드가 무대 폭 전체를 쓴다 */
+.tbx-stage-bare .tbx-teams { grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); }
+.tbx-tool[data-fullscreen="true"] .tbx-member { font-size: 18px; }
