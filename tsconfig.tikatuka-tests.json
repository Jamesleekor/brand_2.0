{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "rootDir": ".",
    "outDir": ".tikatuka-test-build",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": false
  },
  "include": [
    "src/features/arcade/tikatuka/engine/**/*.ts",
    "src/features/arcade/tikatuka/tests/**/*.ts"
  ]
}
